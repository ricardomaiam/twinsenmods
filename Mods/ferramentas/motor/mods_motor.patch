+/* ------------------------------------------------ nome do lugar (caixinha) */
+
+// nomes das ilhas = textos do holomapa (banco 2, mensagem do TabArrow), no
+// idioma do jogo; o mar aberto nao tem texto no jogo
+#define MM_TEXT_LANG 15 // bancos de texto por idioma no TEXT.HQR (MAX_TEXT_LANG do MESSAGE.CPP)
+static char MmNames[12][48];
+static S32 MmNamesLang = -1;
+
+static void LoadNames(void) {
+    char path[ADELINE_MAX_PATH];
+    U8 *order, *text;
+    S32 n, i, k, cnt;
+    MmNamesLang = Language;
+    for (i = 0; i < 12; i++)
+        MmNames[i][0] = 0;
+    GetResPath(path, ADELINE_MAX_PATH, TEXT_HQR_NAME);
+    order = (U8 *)LoadMalloc_HQR(path, Language * MM_TEXT_LANG * 2 + 2 * 2);
+    cnt = order ? (S32)LoadMallocFileSize / 2 : 0;
+    text = (U8 *)LoadMalloc_HQR(path, Language * MM_TEXT_LANG * 2 + 2 * 2 + 1);
+    if (order AND text)
+        for (i = 0; i < 12; i++)
+            for (n = 0; n < cnt; n++)
+                if ((S32)ReadLE_U16(order + n * 2) == TabArrow[i].Mess) {
+                    const char *src = (const char *)text + ReadLE_U16(text + n * 2) + 1; // 1o byte: tipo
+                    for (k = 0; k < 47 AND src[k]; k++)
+                        MmNames[i][k] = src[k];
+                    while (k > 0 AND (MmNames[i][k - 1] == '.' OR MmNames[i][k - 1] == ' '))
+                        k--;
+                    MmNames[i][k] = 0;
+                    break;
+                }
+    if (order)
+        Free(order);
+    if (text)
+        Free(text);
+}
+
+// texto com a fonte do jogo, reduzido (cobertura 0..16 por pixel)
+#define MM_TXT_H 11
+typedef struct {
+    U8 *cov;
+    S32 w, h;
+    char str[96];
+} T_MM_TXT;
+static T_MM_TXT TxtPlace, TxtMsg;
+
+static void RenderText(T_MM_TXT *t, const char *str) {
+    S32 fullW = 0, fullH = 0, x, y, i, ox;
+    U8 *bmp;
+    const char *c;
+    double sc;
+    if (!strcmp(str, t->str) AND t->cov)
+        return;
+    strncpy(t->str, str, 95);
+    t->str[95] = 0;
+    free(t->cov);
+    t->cov = NULL;
+    t->w = t->h = 0;
+    if (!LbaFont)
+        return;
+    for (c = str; *c; c++) {
+        U8 ch = (U8)*c;
+        if (ch == 32)
+            fullW += 8;
+        else {
+            U8 *d = LbaFont + ReadLE_U32(LbaFont + ch * 4);
+            fullW += d[0] + 2;
+            if (d[3] + d[1] > fullH)
+                fullH = d[3] + d[1];
+        }
+    }
+    if (fullW <= 0 OR fullH <= 0)
+        return;
+    bmp = (U8 *)calloc(fullW * fullH, 1);
+    if (!bmp)
+        return;
+    ox = 0;
+    for (c = str; *c; c++) {
+        U8 ch = (U8)*c, *d, *gr;
+        if (ch == 32) {
+            ox += 8;
+            continue;
+        }
+        d = LbaFont + ReadLE_U32(LbaFont + ch * 4);
+        gr = d + 4;
+        for (y = 0; y < d[1]; y++) {
+            S32 nb = *gr++, px = ox + d[2];
+            U8 *row = bmp + (d[3] + y) * fullW;
+            while (nb > 0) {
+                px += gr[0];
+                nb--;
+                if (nb == 0) {
+                    gr++;
+                    break;
+                }
+                for (i = 0; i < gr[1]; i++)
+                    if (px + i >= 0 AND px + i < fullW)
+                        row[px + i] = 1;
+                px += gr[1];
+                gr += 2;
+                nb--;
+            }
+        }
+        ox += d[0] + 2;
+    }
+    sc = (double)fullH / MM_TXT_H;
+    t->h = MM_TXT_H;
+    t->w = (S32)(fullW / sc + 1);
+    t->cov = (U8 *)calloc(t->w * t->h, 1);
+    if (t->cov)
+        for (y = 0; y < t->h; y++)
+            for (x = 0; x < t->w; x++) {
+                S32 sx0 = (S32)(x * sc), sx1 = (S32)((x + 1) * sc), sy0 = (S32)(y * sc), sy1 = (S32)((y + 1) * sc), sum = 0,
+                    tot = 0, a, b;
+                if (sx1 > fullW)
+                    sx1 = fullW;
+                if (sy1 > fullH)
+                    sy1 = fullH;
+                for (b = sy0; b < sy1; b++)
+                    for (a = sx0; a < sx1; a++) {
+                        sum += bmp[b * fullW + a];
+                        tot++;
+                    }
+                t->cov[y * t->w + x] = tot ? (U8)((sum * 16 + tot / 2) / tot) : 0;
+            }
+    free(bmp);
+}
+
+static U8 MmBlend(U8 under, U32 rgb, S32 a16) {
+    U32 c = MmRgb[under];
+    U32 r = (((rgb >> 10) & 31) * a16 + ((c >> 10) & 31) * (16 - a16)) >> 4;
+    U32 g = (((rgb >> 5) & 31) * a16 + ((c >> 5) & 31) * (16 - a16)) >> 4;
+    U32 b = ((rgb & 31) * a16 + (c & 31) * (16 - a16)) >> 4;
+    return MmLut[(r << 10) | (g << 5) | b];
+}
+
+static U32 MmLutPal = 0;
+static S32 MmLutOk = FALSE;
+
+static void EnsureBlend(void) {
+    U32 sum = PalSum();
+    if (MmLutOk AND sum == MmLutPal)
+        return;
+    BuildBlendLut();
+    MmLutPal = sum;
+    MmLutOk = TRUE;
+}
+
+// caixa no estilo do inventario (fundo escurecido, moldura azul) com um texto
+static void DrawBoxText(S32 x0, S32 by, S32 w, T_MM_TXT *t) {
+    S32 h = t->h + 9, bx, x, y;
+    U8 *shade = PtrCLUTGouraud + (15 - MM_SHADE) * 256;
+    if (x0 < 2)
+        x0 = 2;
+    if (x0 + w > (S32)ModeDesiredX - 2)
+        w = (S32)ModeDesiredX - 2 - x0;
+    if (by < 0 OR by + h >= (S32)ModeDesiredY OR w < 12)
+        return;
+    EnsureBlend();
+    for (y = 0; y < h; y++) {
+        U8 *line = (U8 *)Log + TabOffLine[by + y] + x0;
+        S32 ey = y < h - 1 - y ? y : h - 1 - y;
+        for (x = 0; x < w; x++) {
+            S32 ex = x < w - 1 - x ? x : w - 1 - x;
+            if (ex == 0 OR ey == 0 OR ex + ey < 6)
+                continue;
+            line[x] = shade[line[x]];
+        }
+    }
+    bx = x0 + (w - t->w) / 2;
+    for (y = 0; y < t->h; y++)
+        for (x = 0; x < t->w; x++) {
+            S32 a = t->cov[y * t->w + x], px = bx + x, py = by + 5 + y;
+            if (!a OR px + 1 >= x0 + w - 2 OR px < x0 + 2)
+                continue;
+            {
+                U8 *p1 = (U8 *)Log + TabOffLine[py + 1] + px + 1; // sombra
+                *p1 = MmBlend(*p1, 0, a * 3 / 4);
+            }
+        }
+    for (y = 0; y < t->h; y++)
+        for (x = 0; x < t->w; x++) {
+            S32 a = t->cov[y * t->w + x], px = bx + x, py = by + 5 + y;
+            if (!a OR px >= x0 + w - 2 OR px < x0 + 2)
+                continue;
+            {
+                U8 *p0 = (U8 *)Log + TabOffLine[py] + px;
+                *p0 = MmBlend(*p0, (30 << 10) | (30 << 5) | 28, a);
+            }
+        }
+    DrawCadre(x0, by, x0 + w - 1, by + h - 1, ALL_ANGLES);
+    BoxMovingAdd(x0, by, x0 + w - 1, by + h - 1);
+}
