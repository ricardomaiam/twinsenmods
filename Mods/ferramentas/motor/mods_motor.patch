diff --git a/SOURCES/SPACE.CPP b/SOURCES/SPACE.CPP
new file mode 100644
index 0000000..5f121bc
--- /dev/null
+++ b/SOURCES/SPACE.CPP
@@ -0,0 +1,752 @@
+/* SPACE.CPP - Mini espaco (mod). Ver SPACE.H.
+ *
+ * Desenhado inteiro aqui, pixel a pixel, no lugar da cena: ceu estrelado, os
+ * dois sois de Twinsun nos polos, e os tres mundos como esferas com as
+ * texturas do holomapa (HOLOMAP.HQR: 256x256, mapeamento equirretangular
+ * igual ao do globo do holomapa). A nave Esmer e desenhada pelo proprio motor
+ * (com a anim dela: trem de pouso recolhido) por cima.
+ *
+ * A cena da ilha de onde a nave saiu continua carregada por baixo (nao e
+ * desenhada); ao chegar perto de um mundo, a ilha dele mais proxima do ponto
+ * de chegada e carregada com a nave junto, alto no ceu.
+ */
+#include "C_EXTERN.H"
+#include "SPACE.H"
+#include "PILOT.H"
+#include "SHIPFX.H"
+#include "WORLDMAP.H"
+#include "MODSENV.H"
+#include "DIRECTORIES.H"
+#include "HQR_NAMES.H"
+#include "INTEXT.H"
+#include "MUSIC.H"
+
+#include <SVGA/SCREEN.H>
+#include <SVGA/GPRINTF.H>
+#include <SVGA/AFFSTR.H>
+#include <3D/CAMERA.H>
+#include <3D/PROJ.H>
+#include <OBJECT/AFF_OBJ.H>
+#include <POLYGON/POLY.H>
+#include <SYSTEM/LOGPRINT.H>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+S32 SpaceEnabled = TRUE;
+S32 SpaceDbg = 0;
+
+#define PI 3.14159265358979
+#define NB_STARS 1600
+#define SPACE_JINGLE 7 // musica da Lua Esmeralda (cena 75)
+
+typedef struct {
+    const char *name;
+    S32 holo;           // indice do planeta no holomapa (texturas)
+    double cx, cy, cz;  // centro
+    double r;           // raio
+    double atR, atG, atB; // cor da atmosfera
+    S32 islands[6];     // ilhas desse mundo (-1 termina)
+    U8 *tex;            // 256x256 (indices da paleta)
+} T_SPACE_PLANET;
+
+static T_SPACE_PLANET Planets[3] = {
+    {"TWINSUN", 0, 0.0, 0.0, 0.0, 1000.0, 90, 150, 255, {0, 2, -1}, NULL},
+    {"LUA ESMERALDA", 1, 2600.0, 700.0, -1700.0, 330.0, 120, 220, 160, {3, -1}, NULL},
+    {"ZEELICH", 2, -7200.0, -900.0, -7600.0, 1350.0, 170, 130, 210, {4, 5, 8, 9, 10, -1}, NULL},
+};
+
+static S32 Active = FALSE;
+static S32 ShipObj = -1;
+static double PX, PY, PZ;       // posicao da nave
+static double Yaw, Pitch;       // direcao
+static double Speed, TurnVel, Roll;
+static U32 HoldFwdSince = 0;
+static S32 FromPlanet = 0;
+
+static float StarX[NB_STARS], StarY[NB_STARS], StarZ[NB_STARS];
+static U8 StarB[NB_STARS];
+static S32 StarsBuilt = FALSE;
+
+static U8 Lut[32 * 32 * 32];
+static U32 LutPalSum = 0;
+static S32 LutOk = FALSE;
+
+static double IslDir[12][3];
+static S32 IslDirOk = FALSE;
+
+S32 Space_Active(void) {
+    return Active;
+}
+
+/* ---------------------------------------------------------------- recursos */
+
+static U32 PalSum(void) {
+    U32 s = 0;
+    S32 i;
+    if (PtrPal)
+        for (i = 0; i < 768; i++)
+            s = s * 31 + PtrPal[i];
+    return s;
+}
+
+static S32 Pal6 = 0;
+
+static void BuildLut(void) {
+    S32 r, g, b, i, mx = 0;
+    U32 sum = PalSum();
+    if (LutOk AND sum == LutPalSum)
+        return;
+    LutPalSum = sum;
+    LutOk = TRUE;
+    for (i = 0; i < 768; i++)
+        if (PtrPal[i] > mx)
+            mx = PtrPal[i];
+    Pal6 = mx < 64;
+    for (r = 0; r < 32; r++)
+        for (g = 0; g < 32; g++)
+            for (b = 0; b < 32; b++) {
+                S32 tr = r * 255 / 31, tg = g * 255 / 31, tb = b * 255 / 31, best = 0, bd = 0x7FFFFFFF;
+                if (Pal6) {
+                    tr >>= 2;
+                    tg >>= 2;
+                    tb >>= 2;
+                }
+                for (i = 0; i < 256; i++) {
+                    S32 dr = PtrPal[i * 3] - tr, dg = PtrPal[i * 3 + 1] - tg, db = PtrPal[i * 3 + 2] - tb;
+                    S32 d = dr * dr * 3 + dg * dg * 4 + db * db * 2;
+                    if (d < bd) {
+                        bd = d;
+                        best = i;
+                    }
+                }
+                Lut[(r << 10) | (g << 5) | b] = (U8)best;
+            }
+}
+
+static U8 Col(double r, double g, double b) {
+    S32 ir = (S32)r, ig = (S32)g, ib = (S32)b;
+    if (ir < 0) ir = 0;
+    if (ig < 0) ig = 0;
+    if (ib < 0) ib = 0;
+    if (ir > 255) ir = 255;
+    if (ig > 255) ig = 255;
+    if (ib > 255) ib = 255;
+    return Lut[((ir >> 3) << 10) | ((ig >> 3) << 5) | (ib >> 3)];
+}
+
+static void PalRGB(U8 idx, double *r, double *g, double *b) {
+    S32 k = Pal6 ? 4 : 1;
+    *r = PtrPal[idx * 3] * k;
+    *g = PtrPal[idx * 3 + 1] * k;
+    *b = PtrPal[idx * 3 + 2] * k;
+}
+
+static void LoadTextures(void) {
+    char path[ADELINE_MAX_PATH];
+    S32 p;
+    GetResPath(path, ADELINE_MAX_PATH, HOLO_HQR_NAME);
+    for (p = 0; p < 3; p++) {
+        if (Planets[p].tex)
+            continue;
+        Planets[p].tex = (U8 *)malloc(65536 + 4096);
+        if (Planets[p].tex AND !Load_HQR(path, Planets[p].tex, HQR_TWINSUN_HMG + Planets[p].holo * 2))
+            memset(Planets[p].tex, 0, 65536);
+    }
+}
+
+static void BuildStars(void) {
+    S32 i;
+    U32 seed = 12345;
+    if (StarsBuilt)
+        return;
+    StarsBuilt = TRUE;
+    for (i = 0; i < NB_STARS; i++) {
+        double x, y, z, l;
+        do {
+            seed = seed * 1103515245u + 12345u;
+            x = ((seed >> 8) & 0xFFFF) / 32768.0 - 1.0;
+            seed = seed * 1103515245u + 12345u;
+            y = ((seed >> 8) & 0xFFFF) / 32768.0 - 1.0;
+            seed = seed * 1103515245u + 12345u;
+            z = ((seed >> 8) & 0xFFFF) / 32768.0 - 1.0;
+            l = x * x + y * y + z * z;
+        } while (l > 1.0 OR l < 0.01);
+        l = sqrt(l);
+        StarX[i] = (float)(x / l);
+        StarY[i] = (float)(y / l);
+        StarZ[i] = (float)(z / l);
+        seed = seed * 1103515245u + 12345u;
+        StarB[i] = (U8)(60 + ((seed >> 16) % 196));
+    }
+}
+
+// direcao de cada ilha no globo, com as mesmas contas do holomapa
+static void BuildIslandDirs(void) {
+    S32 i;
+    if (IslDirOk)
+        return;
+    IslDirOk = TRUE;
+    SaveCamera();
+    for (i = 0; i < 12; i++) {
+        double l;
+        SetAngleCamera(TabArrow[i].Alpha, TabArrow[i].Beta, 0);
+        LongWorldRotatePoint(0, 0, 1000);
+        l = sqrt((double)X0 * X0 + (double)Y0 * Y0 + (double)Z0 * Z0);
+        if (l < 1)
+            l = 1;
+        IslDir[i][0] = X0 / l;
+        IslDir[i][1] = Y0 / l;
+        IslDir[i][2] = Z0 / l;
+    }
+    RestoreCamera();
+}
+
+/* ---------------------------------------------------------------- entrar */
+
+static S32 PlanetOfIsland(S32 isl) {
+    S32 p, k;
+    for (p = 0; p < 3; p++)
+        for (k = 0; Planets[p].islands[k] >= 0; k++)
+            if (Planets[p].islands[k] == isl)
+                return p;
+    return -1;
+}
+
+static void StartAt(S32 p, S32 isl) {
+    T_SPACE_PLANET *pl = &Planets[p];
+    double dx = 0, dy = 1, dz = 0;
+    BuildIslandDirs();
+    if (isl >= 0 AND isl < 12) {
+        dx = IslDir[isl][0];
+        dy = IslDir[isl][1];
+        dz = IslDir[isl][2];
+    }
+    // sai do lado da ilha, mas ja inclinado para o mundo vizinho, que fica
+    // a frente da camera (o mundo de onde saiu fica atras, embaixo)
+    {
+        static const S32 Target[3] = {2, 0, 0};
+        T_SPACE_PLANET *tg = &Planets[Target[p]];
+        double tx = tg->cx - pl->cx, ty = tg->cy - pl->cy, tz = tg->cz - pl->cz, l = sqrt(tx * tx + ty * ty + tz * tz);
+        double ox, oy, oz;
+        tx /= l;
+        ty /= l;
+        tz /= l;
+        ox = dx + tx * 1.3;
+        oy = dy + ty * 1.3;
+        oz = dz + tz * 1.3;
+        l = sqrt(ox * ox + oy * oy + oz * oz);
+        if (l < 1e-3) {
+            ox = tx;
+            oy = ty;
+            oz = tz;
+            l = 1;
+        }
+        PX = pl->cx + ox / l * pl->r * 1.3;
+        PY = pl->cy + oy / l * pl->r * 1.3;
+        PZ = pl->cz + oz / l * pl->r * 1.3;
+        tx = tg->cx - PX;
+        ty = tg->cy - PY;
+        tz = tg->cz - PZ;
+        l = sqrt(tx * tx + ty * ty + tz * tz);
+        Yaw = atan2(tx, tz);
+        Pitch = asin(ty / l);
+    }
+    if (Pitch > 1.2)
+        Pitch = 1.2;
+    if (Pitch < -1.2)
+        Pitch = -1.2;
+    Speed = 220.0;
+    TurnVel = Roll = 0.0;
+    HoldFwdSince = 0;
+    FromPlanet = p;
+    LoadTextures();
+    BuildStars();
+    LutOk = FALSE;
+    BuildLut();
+    Active = TRUE;
+    PlayMusic(SPACE_JINGLE, TRUE); // a musica da Lua Esmeralda
+    if (SpaceDbg)
+        LogPrintf("Space: entrou no espaco saindo de %s (ilha %d)\n", pl->name, isl);
+}
+
+S32 Space_TryEnter(S32 numobj) {
+    S32 isl, p;
+    if (!SpaceEnabled OR Active OR CubeMode != CUBE_EXTERIEUR)
+        return FALSE;
+    isl = Island;
+    p = PlanetOfIsland(isl);
+    if (p < 0)
+        return FALSE; // sob o gas: nao ha ceu
+    ShipObj = numobj;
+    StartAt(p, isl);
+    return TRUE;
+}
+
+void Space_Test(S32 planet) {
+    if (!Pilot_Active() OR planet < 0 OR planet > 2)
+        return;
+    ShipObj = Pilot_ShipObj();
+    StartAt(planet, Planets[planet].islands[0]);
+}
+
+/* ---------------------------------------------------------------- chegar */
+
+/* Modo historia: um mundo so pode ser alcancado se alguma ilha dele ja foi
+   liberada; senao fica envolto numa camada branca transparente que nao deixa
+   pousar. Twinsun (de onde se comeca) esta sempre liberado. */
+static U32 LockMsgUntil = 0;
+static S32 LockedSeen = FALSE; // um mundo bloqueado esta na tela neste quadro
+static S32 LockedX, LockedY;    // centro dele na tela (o aviso fica em cima dele)
+
+static S32 PlanetLocked(S32 p) {
+    S32 k;
+    if (p == 0)
+        return FALSE;
+    for (k = 0; Planets[p].islands[k] >= 0; k++)
+        if (World_IslandUnlocked(Planets[p].islands[k]))
+            return FALSE;
+    return TRUE;
+}
+
+static void Land(S32 p) {
+    T_SPACE_PLANET *pl = &Planets[p];
+    double dx = PX - pl->cx, dy = PY - pl->cy, dz = PZ - pl->cz, l = sqrt(dx * dx + dy * dy + dz * dz);
+    S32 k, best = pl->islands[0];
+    double bestDot = -2.0;
+    BuildIslandDirs();
+    dx /= l;
+    dy /= l;
+    dz /= l;
+    for (k = 0; pl->islands[k] >= 0; k++) {
+        S32 i = pl->islands[k];
+        double d = dx * IslDir[i][0] + dy * IslDir[i][1] + dz * IslDir[i][2];
+        if (!World_IslandUnlocked(i))
+            continue; // modo historia: so as ilhas ja liberadas
+        if (d > bestDot) {
+            bestDot = d;
+            best = i;
+        }
+    }
+    Active = FALSE;
+    if (SpaceDbg)
+        LogPrintf("Space: chegando em %s, ilha %d\n", pl->name, best);
+    Pilot_SetAltitude(SPACE_ARRIVE_ALT);
+    World_TeleportIsland(best, 16384, SPACE_ARRIVE_ALT, 16384);
+}
+
+/* ---------------------------------------------------------------- pilotar */
+
+void Space_Update(S32 dt, S32 fwd, S32 back, S32 turn, S32 vert) {
+    double dts = dt / 1000.0, fx, fy, fz, vmax;
+    S32 p;
+    if (!Active)
+        return;
+
+    // giro e inclinacao (E/Q levanta/abaixa o nariz)
+    {
+        double want = turn * 1.5, k = dts * 4.0;
+        if (k > 1.0)
+            k = 1.0;
+        TurnVel += (want - TurnVel) * k;
+        Yaw += TurnVel * dts;
+        Roll += ((TurnVel * 0.45) - Roll) * (k > 1 ? 1 : k);
+    }
+    Pitch += vert * 0.9 * dts;
+    if (Pitch > 1.3)
+        Pitch = 1.3;
+    if (Pitch < -1.3)
+        Pitch = -1.3;
+
+    // motor: no espaco a nave mantem o embalo
+    if (fwd) {
+        if (!HoldFwdSince)
+            HoldFwdSince = TimerRefHR;
+    } else
+        HoldFwdSince = 0;
+    vmax = (fwd AND HoldFwdSince AND TimerRefHR - HoldFwdSince > 2000) ? 1500.0 : 650.0;
+    if (fwd) {
+        Speed += 450.0 * dts;
+        if (Speed > vmax)
+            Speed -= (Speed - vmax) * (dts * 2 > 1 ? 1 : dts * 2);
+    } else if (back) {
+        Speed -= 600.0 * dts;
+        if (Speed < -150.0)
+            Speed = -150.0;
+    } else
+        Speed -= Speed * 0.15 * dts;
+
+    fx = cos(Pitch) * sin(Yaw);
+    fy = sin(Pitch);
+    fz = cos(Pitch) * cos(Yaw);
+    PX += fx * Speed * dts;
+    PY += fy * Speed * dts;
+    PZ += fz * Speed * dts;
+
+    // limite do espaco
+    {
+        double l = sqrt(PX * PX + PY * PY + PZ * PZ), lim = 22000.0;
+        if (l > lim) {
+            PX *= lim / l;
+            PY *= lim / l;
+            PZ *= lim / l;
+            Speed *= 0.5;
+        }
+    }
+
+    // chegou perto de um mundo
+    for (p = 0; p < 3; p++) {
+        double dx = PX - Planets[p].cx, dy = PY - Planets[p].cy, dz = PZ - Planets[p].cz;
+        double d = sqrt(dx * dx + dy * dy + dz * dz);
+        if (d < Planets[p].r * 1.10 AND !(p == FromPlanet AND Speed > 0 AND (dx * fx + dy * fy + dz * fz) > 0)) {
+            if (PlanetLocked(p)) {
+                // a camada nao deixa passar: a nave fica na beirada, parada
+                double k = Planets[p].r * 1.10 / (d > 1 ? d : 1);
+                PX = Planets[p].cx + dx * k;
+                PY = Planets[p].cy + dy * k;
+                PZ = Planets[p].cz + dz * k;
+                if (Speed > 0 AND (dx * fx + dy * fy + dz * fz) < 0)
+                    Speed = 0;
+                LockMsgUntil = TimerRefHR + 2500;
+                continue;
+            }
+            Land(p);
+            return;
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- desenho */
+
+typedef struct {
+    double cx, cy, cz;     // posicao da camera
+    double rx, ry, rz;     // direita
+    double ux, uy, uz;     // cima
+    double fx, fy, fz;     // frente
+    double F;              // foco em pixels
+    S32 w, h, xc, yc;
+} T_SCAM;
+
+static void MakeCam(T_SCAM *c) {
+    // camera atras e acima da nave, olhando para ela (como o motor a desenha)
+    double camPitch = Pitch - 0.25; // um pouco abaixo: o destino aparece acima da nave
+    double dx = cos(camPitch) * sin(Yaw), dy = sin(camPitch), dz = cos(camPitch) * cos(Yaw);
+    double l;
+    c->fx = dx;
+    c->fy = dy;
+    c->fz = dz;
+    c->cx = PX - dx * 160.0;
+    c->cy = PY - dy * 160.0;
+    c->cz = PZ - dz * 160.0;
+    // direita = frente x cima(mundo)
+    c->rx = dz;
+    c->ry = 0.0;
+    c->rz = -dx;
+    l = sqrt(c->rx * c->rx + c->rz * c->rz);
+    if (l < 1e-6) {
+        c->rx = 1;
+        c->rz = 0;
+        l = 1;
+    }
+    c->rx /= l;
+    c->rz /= l;
+    // cima = frente x direita
+    c->ux = c->fy * c->rz - c->fz * c->ry;
+    c->uy = c->fz * c->rx - c->fx * c->rz;
+    c->uz = c->fx * c->ry - c->fy * c->rx;
+    // rolamento leve da camera na curva
+    {
+        double a = Roll * 0.35, ca = cos(a), sa = sin(a);
+        double rx = c->rx * ca + c->ux * sa, ry = c->ry * ca + c->uy * sa, rz = c->rz * ca + c->uz * sa;
+        double ux = c->ux * ca - c->rx * sa, uy = c->uy * ca - c->ry * sa, uz = c->uz * ca - c->rz * sa;
+        c->rx = rx;
+        c->ry = ry;
+        c->rz = rz;
+        c->ux = ux;
+        c->uy = uy;
+        c->uz = uz;
+    }
+    c->w = (S32)ModeDesiredX;
+    c->h = (S32)ModeDesiredY;
+    c->xc = c->w / 2;
+    c->yc = c->h / 2;
+    c->F = c->w * 0.95;
+}
+
+static S32 ProjectDir(const T_SCAM *c, double dx, double dy, double dz, S32 *sx, S32 *sy) {
+    double z = dx * c->fx + dy * c->fy + dz * c->fz;
+    if (z <= 0.01)
+        return FALSE;
+    *sx = c->xc + (S32)((dx * c->rx + dy * c->ry + dz * c->rz) / z * c->F);
+    *sy = c->yc - (S32)((dx * c->ux + dy * c->uy + dz * c->uz) / z * c->F);
+    return TRUE;
+}
+
+static inline void Put(S32 x, S32 y, U8 col) {
+    if (x < 0 OR y < 0 OR x >= (S32)ModeDesiredX OR y >= (S32)ModeDesiredY)
+        return;
+    ((U8 *)Log)[TabOffLine[y] + x] = col;
+}
+
+// os dois sois de Twinsun, nos polos
+static const double SunDir[2][3] = {{0.10, 0.99, 0.08}, {-0.08, -0.99, -0.10}};
+
+static void DrawSuns(const T_SCAM *c) {
+    S32 s, x, y, sx, sy;
+    for (s = 0; s < 2; s++) {
+        double l = sqrt(SunDir[s][0] * SunDir[s][0] + SunDir[s][1] * SunDir[s][1] + SunDir[s][2] * SunDir[s][2]);
+        if (!ProjectDir(c, SunDir[s][0] / l, SunDir[s][1] / l, SunDir[s][2] / l, &sx, &sy))
+            continue;
+        for (y = -46; y <= 46; y++)
+            for (x = -46; x <= 46; x++) {
+                double d = sqrt((double)(x * x + y * y));
+                U8 *px;
+                double r, g, b, a;
+                if (sx + x < 0 OR sy + y < 0 OR sx + x >= c->w OR sy + y >= c->h OR d > 46)
+                    continue;
+                px = (U8 *)Log + TabOffLine[sy + y] + sx + x;
+                PalRGB(*px, &r, &g, &b);
+                if (d < 14) {
+                    *px = Col(255, 250, 215);
+                    continue;
+                }
+                a = (46 - d) / 32.0; // brilho em volta
+                a = a * a * 0.8;
+                *px = Col(r + (255 - r) * a, g + (215 - g) * a, b + (120 - b) * a * 0.6);
+            }
+    }
+}
+
+static void DrawStars(const T_SCAM *c) {
+    S32 i, sx, sy;
+    for (i = 0; i < NB_STARS; i++) {
+        if (!ProjectDir(c, StarX[i], StarY[i], StarZ[i], &sx, &sy))
+            continue;
+        if (sx < 0 OR sy < 0 OR sx >= c->w OR sy >= c->h)
+            continue;
+        {
+            S32 b = StarB[i];
+            U8 col = Col(b, b, b * 0.9 + 25);
+            Put(sx, sy, col);
+            if (b > 235) {
+                Put(sx + 1, sy, col);
+                Put(sx, sy + 1, col);
+            }
+        }
+    }
+}
+
+static void DrawPlanet(const T_SCAM *c, T_SPACE_PLANET *pl) {
+    S32 locked = PlanetLocked((S32)(pl - Planets));
+    double ox = c->cx - pl->cx, oy = c->cy - pl->cy, oz = c->cz - pl->cz;
+    double dist = sqrt(ox * ox + oy * oy + oz * oz), rr = pl->r * pl->r;
+    S32 sx, sy, x0, y0, x1, y1, x, y;
+    double rpix;
+    double cdx = -ox / dist, cdy = -oy / dist, cdz = -oz / dist;
+
+    if (!pl->tex)
+        return;
+    // caixa na tela
+    if (dist <= pl->r * 1.02) {
+        x0 = 0;
+        y0 = 0;
+        x1 = c->w - 1;
+        y1 = c->h - 1;
+    } else {
+        double zc = cdx * c->fx + cdy * c->fy + cdz * c->fz;
+        double ang = asin(pl->r / dist);
+        if (zc < cos(ang + 0.9 + atan((double)c->w / c->F)))
+            return; // atras da camera
+        if (ProjectDir(c, cdx, cdy, cdz, &sx, &sy) AND zc > 0.3) {
+            rpix = tan(ang) * c->F / zc * 1.2 + 4;
+            x0 = sx - (S32)rpix;
+            x1 = sx + (S32)rpix;
+            y0 = sy - (S32)rpix;
+            y1 = sy + (S32)rpix;
+        } else {
+            x0 = 0;
+            y0 = 0;
+            x1 = c->w - 1;
+            y1 = c->h - 1;
+        }
+    }
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > c->w - 1) x1 = c->w - 1;
+    if (y1 > c->h - 1) y1 = c->h - 1;
+    if (locked AND x0 <= x1 AND y0 <= y1 AND (x1 - x0) >= 8)
+    {
+        S32 px, py;
+        LockedSeen = TRUE; // da para ver a camada: o aviso aparece
+        // no meio do mundo; se o centro estiver fora da tela, no meio da parte visivel
+        if (ProjectDir(c, cdx, cdy, cdz, &px, &py) AND px >= x0 AND px <= x1 AND py >= y0 AND py <= y1) {
+            LockedX = px;
+            LockedY = py;
+        } else {
+            LockedX = (x0 + x1) / 2;
+            LockedY = (y0 + y1) / 2;
+        }
+    }
+
+    for (y = y0; y <= y1; y++) {
+        U8 *line = (U8 *)Log + TabOffLine[y];
+        double vy = (c->yc - y) / c->F;
+        for (x = x0; x <= x1; x++) {
+            double vx = (x - c->xc) / c->F;
+            double dx = c->fx + c->rx * vx + c->ux * vy;
+            double dy = c->fy + c->ry * vx + c->uy * vy;
+            double dz = c->fz + c->rz * vx + c->uz * vy;
+            double il = 1.0 / sqrt(dx * dx + dy * dy + dz * dz), b, cc, disc, t;
+            dx *= il;
+            dy *= il;
+            dz *= il;
+            b = ox * dx + oy * dy + oz * dz;
+            cc = ox * ox + oy * oy + oz * oz - rr;
+            disc = b * b - cc;
+            if (disc <= 0) {
+                // halo da atmosfera logo fora da borda
+                double near = -b, d2;
+                if (near > 0) {
+                    d2 = cc - b * b + rr; // distancia^2 do raio ao centro
+                    if (d2 < rr * 1.06 * 1.06) {
+                        double k = 1.0 - (sqrt(d2) / pl->r - 1.0) / 0.06, r, g, bb;
+                        if (k > 0) {
+                            k = k * k * 0.55;
+                            PalRGB(line[x], &r, &g, &bb);
+                            line[x] = Col(r + (pl->atR - r) * k, g + (pl->atG - g) * k, bb + (pl->atB - bb) * k);
+                        }
+                    }
+                    if (locked AND d2 < rr * 1.10 * 1.10) { // camada branca do modo historia
+                        double r, g, bb, e = sqrt(d2) / pl->r, k = e > 1.07 ? 0.55 : 0.30;
+                        PalRGB(line[x], &r, &g, &bb);
+                        line[x] = Col(r + (245 - r) * k, g + (245 - g) * k, bb + (250 - bb) * k);
+                    }
+                }
+                continue;
+            }
+            t = -b - sqrt(disc);
+            if (t <= 0)
+                continue;
+            {
+                double nx = (ox + dx * t) / pl->r, ny = (oy + dy * t) / pl->r, nz = (oz + dz * t) / pl->r;
+                double al = asin(-ny < -1 ? -1 : (-ny > 1 ? 1 : -ny)); // -pi/2..pi/2
+                double be = atan2(-nz, nx);                             // -pi..pi
+                S32 tx, ty;
+                double r, g, bb, light, rim, l0, l1;
+                if (be < 0)
+                    be += 2 * PI;
+                tx = ((S32)(be / (2 * PI) * 256.0)) & 255;
+                ty = (S32)((al / PI + 0.5) * 256.0);
+                if (ty < 0) ty = 0;
+                if (ty > 255) ty = 255;
+                PalRGB(pl->tex[ty * 256 + tx], &r, &g, &bb);
+                // luz dos dois sois + um pouco de ambiente
+                l0 = nx * SunDir[0][0] + ny * SunDir[0][1] + nz * SunDir[0][2];
+                l1 = nx * SunDir[1][0] + ny * SunDir[1][1] + nz * SunDir[1][2];
+                light = 0.55 + 0.45 * ((l0 > 0 ? l0 : 0) + (l1 > 0 ? l1 : 0));
+                // borda azulada (atmosfera)
+                rim = 1.0 + (nx * dx + ny * dy + nz * dz); // 0 no centro, 1 na borda
+                rim = rim * rim * rim * 0.6;
+                r = r * light;
+                g = g * light;
+                bb = bb * light;
+                line[x] = Col(r + (pl->atR - r) * rim, g + (pl->atG - g) * rim, bb + (pl->atB - bb) * rim);
+                if (locked) { // por cima do mundo bloqueado, a camada branca
+                    PalRGB(line[x], &r, &g, &bb);
+                    line[x] = Col(r + (240 - r) * 0.38, g + (240 - g) * 0.38, bb + (248 - bb) * 0.38);
+                }
+            }
+        }
+    }
+}
+
+void Space_Draw(void) {
+    T_SCAM cam;
+    S32 order[3] = {0, 1, 2}, i, j;
+    double dd[3];
+
+    if (!Active)
+        return;
+    BuildLut();
+    MakeCam(&cam);
+
+    // fundo preto
+    {
+        U8 black = Col(0, 0, 0);
+        S32 y;
+        for (y = 0; y < cam.h; y++)
+            memset((U8 *)Log + TabOffLine[y], black, cam.w);
+    }
+    DrawStars(&cam);
+    DrawSuns(&cam);
+
+    LockedSeen = FALSE;
+    // mundos, do mais longe para o mais perto
+    for (i = 0; i < 3; i++) {
+        double dx = Planets[i].cx - cam.cx, dy = Planets[i].cy - cam.cy, dz = Planets[i].cz - cam.cz;
+        dd[i] = dx * dx + dy * dy + dz * dz;
+    }
+    for (i = 0; i < 3; i++)
+        for (j = i + 1; j < 3; j++)
+            if (dd[order[j]] > dd[order[i]]) {
+                S32 t = order[i];
+                order[i] = order[j];
+                order[j] = t;
+            }
+    for (i = 0; i < 3; i++)
+        DrawPlanet(&cam, &Planets[order[i]]);
+    if (SpaceDbg) {
+        static S32 n = 0;
+        if ((n++ % 25) == 0)
+            for (i = 0; i < 3; i++) {
+                double dx = Planets[i].cx - cam.cx, dy = Planets[i].cy - cam.cy, dz = Planets[i].cz - cam.cz, d = sqrt(dd[i]);
+                LogPrintf("Space: P=(%.0f,%.0f,%.0f) yaw %.2f pitch %.2f thr %.2f | %s d %.0f zc %.2f tex %p\n", PX, PY, PZ, Yaw, Pitch, Pilot_Thrust(),
+                          Planets[i].name, d, (dx * cam.fx + dy * cam.fy + dz * cam.fz) / d, (void *)Planets[i].tex);
+            }
+    }
+
+    // a nave, desenhada pelo motor, no meio da tela
+    if (ShipObj >= 0 AND ShipObj < NbObjets AND ListObjet[ShipObj].Obj.Body.Num != -1) {
+        T_OBJ_3D *o = &ListObjet[ShipObj].Obj;
+        S32 ma = o->Alpha, mb = o->Beta, mg = o->Gamma;
+        SaveCamera();
+        o->Alpha = 0;
+        o->Beta = 0;
+        o->Gamma = ((S32)(Roll * 2048.0 / PI)) & 4095;
+        SetFollowCamera(o->X, o->Y, o->Z, 300, 2048, 0, 15000);
+        SetLightVector(800, 1024, 0);
+        Switch_Fillers(FILL_POLY_TEXTURES);
+        {
+            S32 lit = Pilot_DrawBody(ShipObj), memo = o->Body.Num;
+            if (lit >= 0)
+                o->Body.Num = lit; // luzes da nave acesas
+            ObjectDisplay(o);
+            o->Body.Num = memo;
+        }
+        ShipFx_Draw(o, Pilot_Thrust()); // fogo do escapamento
+        o->Alpha = ma;
+        o->Beta = mb;
+        o->Gamma = mg;
+        PtrInit3DView();
+        RestoreCamera();
+    }
+
+    // modo historia: aviso perto de um mundo ainda nao liberado
+    {
+        S32 near = TimerRefHR < LockMsgUntil OR LockedSeen, p;
+        for (p = 0; p < 3 AND !near; p++) {
+            double dx = PX - Planets[p].cx, dy = PY - Planets[p].cy, dz = PZ - Planets[p].cz;
+            if (PlanetLocked(p) AND sqrt(dx * dx + dy * dy + dz * dz) < Planets[p].r * 1.7)
+                near = TRUE;
+        }
+        if (near)
+        {
+            S32 mx = LockedSeen ? LockedX : (S32)ModeDesiredX / 2, my = LockedSeen ? LockedY : (S32)ModeDesiredY / 2;
+            if (mx < 130) mx = 130;
+            if (mx > (S32)ModeDesiredX - 130) mx = (S32)ModeDesiredX - 130;
+            if (my < 20) my = 20;
+            if (my > (S32)ModeDesiredY - 20) my = (S32)ModeDesiredY - 20;
+            World_DrawMsgBox(mx, my, Mods_Text(MODS_TXT_LOCKED)); // em cima do mundo bloqueado
+        }
+    }
+}
diff --git a/SOURCES/SPACE.H b/SOURCES/SPACE.H
