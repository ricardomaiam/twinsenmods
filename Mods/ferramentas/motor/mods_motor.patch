diff --git a/SOURCES/JETFREE.CPP b/SOURCES/JETFREE.CPP
new file mode 100644
index 0000000..6ec5caf
--- /dev/null
+++ b/SOURCES/JETFREE.CPP
@@ -0,0 +1,231 @@
+/* JETFREE.CPP - Jetpack livre (mod). Ver JETFREE.H. */
+
+#include "C_EXTERN.H"
+#include "JETFREE.H"
+#include "PILOT.H"
+#include "ORBIT.H"
+#include "OBJECT.H"
+#include "INTEXT.H"
+#include "INPUT.H"
+#include "3DEXT/VAR_EXT.H"
+#include <SYSTEM/KEYBOARD.H>
+#include <SYSTEM/KEYBOARD_KEYS.H>
+#include <SYSTEM/INPUT.H>
+#include <SYSTEM/TIMER.H>
+#include <SYSTEM/LOGPRINT.H>
+
+#define HEIGHT_JETPACK 543     // mesma altura de voo do jetpack original
+#define HERO_HEAD      1400    // folga acima dos pes para nao entrar no teto
+#define INTERIOR_TOP   (25 * SIZE_BRICK_Y)
+
+S32 JetFreeEnabled = TRUE;
+S32 JetFreeSpeed = 2000;
+S32 JetFreeNoWalls = TRUE; // voando livre, ignora barreiras invisiveis do terreno
+S32 JetFreeTest = 0; // automacao: 1 = segura E, -1 = segura Q
+
+static S32 JetActive = FALSE;
+static S32 JetAlt = 0;      // altura (Y do mundo) desejada
+static S32 JetGround = 0;   // chao sob o heroi no ultimo frame
+static U32 JetLastTime = 0;
+static U32 JetHoldSince = 0;
+
+/* Visao de longe: no alto, afasta o limite de desenho e a neblina para o
+   chao continuar aparecendo. Guarda os valores da cena para restaurar. */
+static S32 FarBase = 0, FogBase = 0, FarSet = -1;
+
+static void JetFree_RestoreFar(void) {
+    if (FarSet != -1 AND ClipZFar == FarSet) {
+        ClipZFar = FarBase;
+        StartZFog = FogBase;
+    }
+    FarSet = -1;
+}
+
+static void UpdateFarFor(S32 alt, S32 ground) {
+    S32 extra;
+    if (CubeMode != CUBE_EXTERIEUR) {
+        FarSet = -1;
+        return;
+    }
+    if (FarSet == -1 OR ClipZFar != FarSet) { // cena nova: valores originais
+        FarBase = ClipZFar;
+        FogBase = StartZFog;
+    }
+    extra = alt - ground - HEIGHT_JETPACK;
+    if (extra < 0)
+        extra = 0;
+    ClipZFar = FarBase + extra;
+    StartZFog = FogBase + extra;
+    FarSet = ClipZFar;
+}
+
+static void JetFree_UpdateFar(void) {
+    UpdateFarFor(JetAlt, JetGround);
+}
+
+/* Visao de voo usada por outros mods (pilotar nave). */
+static S32 ViewActive = FALSE, ViewAlt = 0, ViewGround = 0;
+S32 FlyExtraDist = 0; // camera mais longe (nave grande)
+
+S32 Fly_ExtraDist(void) {
+    return FlyExtraDist;
+}
+
+void Fly_SetView(S32 active, S32 alt, S32 ground) {
+    if (active) {
+        ViewActive = TRUE;
+        ViewAlt = alt;
+        ViewGround = ground;
+        UpdateFarFor(alt, ground);
+    } else if (ViewActive) {
+        ViewActive = FALSE;
+        if (!JetActive)
+            JetFree_RestoreFar();
+    }
+}
+
+S32 JetFree_Active(void) {
+    return JetActive;
+}
+
+void JetFree_Reset(void) {
+    if (JetActive)
+        JetFree_RestoreFar();
+    JetActive = FALSE;
+    JetLastTime = 0;
+    JetHoldSince = 0;
+}
+
+S32 JetFree_Behaviour(S32 ground) {
+    T_OBJET *ptrobj = &ListObjet[NUM_PERSO];
+    S32 up, down, dt, step, minAlt;
+
+    if (!JetFreeEnabled OR Comportement != C_JETPACK OR Pilot_Active()) {
+        JetFree_Reset();
+        return FALSE;
+    }
+
+    up = CheckKey(K_E) OR JetFreeTest > 0;
+
+    down = CheckKey(K_Q) OR JetFreeTest < 0;
+
+    dt = JetLastTime ? (S32)(TimerRefHR - JetLastTime) : 0;
+    if (dt < 0 OR dt > 100)
+        dt = 0;
+    JetLastTime = TimerRefHR;
+
+    JetGround = ground;
+    minAlt = ground + HEIGHT_JETPACK;
+
+    if (!JetActive) {
+        if (!up)
+            return FALSE;
+        // decola (ou sai do voo normal) direto para o modo livre
+        JetActive = TRUE;
+        JetAlt = ptrobj->Obj.Y;
+        if (JetAlt < minAlt)
+            JetAlt = minAlt;
+    }
+
+    // segurando a tecla por mais tempo, sobe/desce mais rapido
+    if (up OR down) {
+        if (!JetHoldSince)
+            JetHoldSince = TimerRefHR;
+    } else
+        JetHoldSince = 0;
+
+    step = JetFreeSpeed * dt / 1000;
+    if (JetHoldSince AND TimerRefHR - JetHoldSince > 1500)
+        step *= 3;
+
+    if (up) {
+        S32 target = JetAlt + step;
+        if (CubeMode == CUBE_INTERIEUR AND target > INTERIOR_TOP - HERO_HEAD)
+            target = INTERIOR_TOP - HERO_HEAD;
+        if (PtrWorldColBrick(ptrobj->Obj.X, target + HERO_HEAD, ptrobj->Obj.Z))
+            target = JetAlt; // teto / objeto em cima
+        JetAlt = target;
+    }
+    if (down)
+        JetAlt -= step;
+
+    if (JetAlt < minAlt) {
+        JetAlt = minAlt;
+        if (down OR !up) {
+            // chegou na altura normal: volta ao jetpack original
+            JetFree_RestoreFar();
+            JetActive = FALSE;
+            ptrobj->Obj.Y = minAlt;
+            return FALSE;
+        }
+    }
+
+    ptrobj->WorkFlags |= FLY_JETPACK;
+    ptrobj->WorkFlags &= ~(FALLING | CHECK_FALLING);
+    StartYFalling = 0;
+
+    // anda para frente voando, ou paira parado
+    if (Input & I_UP) {
+        if (ptrobj->GenAnim != GEN_ANIM_MARCHE)
+            InitAnim(GEN_ANIM_MARCHE, ANIM_REPEAT, NUM_PERSO);
+    } else if (ptrobj->GenAnim != GEN_ANIM_RIEN AND ptrobj->GenAnim != GEN_ANIM_LANCE) {
+        InitAnim(GEN_ANIM_RIEN, ANIM_REPEAT, NUM_PERSO);
+    }
+    return TRUE;
+}
+
+void JetFree_ApplyPos(S32 *y) {
+    T_OBJET *ptrobj = &ListObjet[NUM_PERSO];
+    if (!JetActive)
+        return;
+    if (Comportement != C_JETPACK) {
+        JetFree_Reset();
+        return;
+    }
+    *y = JetAlt;
+    JetFree_UpdateFar();
+    ptrobj->WorkFlags &= ~(FALLING | CHECK_FALLING);
+    StartYFalling = 0;
+}
+
+U16 JetFree_RemapGenAnim(U16 genanim) {
+    if (!JetActive)
+        return genanim;
+    switch (genanim) {
+    case GEN_ANIM_TOMBE:
+    case GEN_ANIM_RECEPTION:
+    case GEN_ANIM_RECEPTION_2:
+    case GEN_ANIM_ARRIMAGE:
+        return (Input & I_UP) ? GEN_ANIM_MARCHE : GEN_ANIM_RIEN;
+    default:
+        return genanim;
+    }
+}
+
+void JetFree_CubeChange(S32 loading) {
+    // voando de uma area para a vizinha: mantem a altura; carregando save: desliga
+    if (loading OR Comportement != C_JETPACK)
+        JetFree_Reset();
+    else
+        JetLastTime = 0;
+}
+
+S32 JetFree_ExtraPitch(S32 baseAlpha) {
+    S32 h, room;
+    if (CubeMode != CUBE_EXTERIEUR OR Orbit_ThirdPerson())
+        return 0; // camera orbital: fica em 3a pessoa, sem olhar de cima
+    if (JetActive)
+        h = (JetAlt - JetGround - HEIGHT_JETPACK) / 8;
+    else if (ViewActive)
+        h = (ViewAlt - ViewGround - HEIGHT_JETPACK) / 8;
+    else
+        return 0;
+    room = 960 - (baseAlpha & 4095); // nunca passa da vertical (1024)
+    if (room < 0)
+        room = 0;
+    return h < 0 ? 0 : (h > room ? room : h);
+}
+
+S32 JetFree_IgnoreTerrainCol(void) {
+    return JetActive AND JetFreeNoWalls AND APtObj == &ListObjet[NUM_PERSO];
+}
diff --git a/SOURCES/JETFREE.H b/SOURCES/JETFREE.H
new file mode 100644
index 0000000..9c126cb
--- /dev/null
+++ b/SOURCES/JETFREE.H
@@ -0,0 +1,47 @@
+/* JETFREE.H - Jetpack livre (mod)
+ *
+ * Com o Super Jetpack, E sobe e Q desce. Enquanto o heroi esta acima da
+ * altura normal do jetpack, ele paira no ar (mesmo sem andar) e a subida nao
+ * tem limite em areas externas. Descendo ate a altura normal, o jetpack volta
+ * a funcionar como no original.
+ */
+#ifndef JETFREE_H
+#define JETFREE_H
+
+#include <SYSTEM/ADELINE_TYPES.H>
+
+extern S32 JetFreeEnabled; // cvar "jetfree" (0 = jetpack original)
+extern S32 JetFreeSpeed;   // velocidade vertical (unidades por segundo)
+extern S32 JetFreeNoWalls;  // cvar "jetfree_walls_off" (1 = sem barreiras invisiveis voando)
+extern S32 JetFreeTest;    // automacao: 1 = segura E, -1 = segura Q
+
+// Chamado no comportamento C_JETPACK. ground = Y do chao sob o heroi.
+// TRUE se o jetpack livre esta controlando a altura (pular a logica original).
+S32 JetFree_Behaviour(S32 ground);
+
+// Chamado por DoAnim antes de gravar a posicao do heroi.
+void JetFree_ApplyPos(S32 *y);
+
+// Troca anims de queda enquanto paira.
+U16 JetFree_RemapGenAnim(U16 genanim);
+
+S32 JetFree_Active(void);
+
+// Inclinacao extra da camera (para baixo) conforme a altura.
+S32 JetFree_ExtraPitch(S32 baseAlpha);
+void JetFree_Reset(void);
+
+// TRUE: GiveTerrainCol ignora os poligonos proibidos (heroi voando livre).
+S32 JetFree_IgnoreTerrainCol(void);
+
+// Visao de voo (distancia de desenho + camera inclinada) para outros mods.
+void Fly_SetView(S32 active, S32 alt, S32 ground);
+
+// Distancia extra da camera (pilotando nave grande).
+extern S32 FlyExtraDist;
+S32 Fly_ExtraDist(void);
+
+// Troca de cena: mantem o voo, exceto ao carregar um save.
+void JetFree_CubeChange(S32 loading);
+
+#endif
diff --git a/SOURCES/MODSENV.CPP b/SOURCES/MODSENV.CPP
new file mode 100644
index 0000000..de566c1
--- /dev/null
+++ b/SOURCES/MODSENV.CPP
@@ -0,0 +1,68 @@
+/* MODSENV.CPP - liga/desliga os mods do motor conforme o Gerenciador de Mods.
+ *
+ * O gerenciador abre o jogo com a variavel de ambiente LBA2_MODS_MOTOR com a
+ * lista dos mods escolhidos (ex.: "swim,pilot"). Sem a variavel, todos ficam
+ * ligados. Os nomes: swim (natacao), jetfree (jetpack livre), pilot (naves),
+ * followcam (camera que segue o heroi, estilo GTA).
+ */
+#include "SWIM.H"
+#include "JETFREE.H"
+#include "PILOT.H"
+#include "FOLLOWCAM.H"
+#include "ORBIT.H"
+#include "ALIENGUN.H"
+#include "WORLDMAP.H"
+#include "MODSENV.H"
+#include "C_EXTERN.H"
+#include <SYSTEM/LOGPRINT.H>
+#include <stdlib.h>
+#include <string.h>
+
+static int HasWord(const char *list, const char *word) {
+    size_t n = strlen(word);
+    const char *p = list;
+    while ((p = strstr(p, word)) != NULL) {
+        int startOk = (p == list) || p[-1] == ',' || p[-1] == ' ';
+        int endOk = p[n] == 0 || p[n] == ',' || p[n] == ' ';
+        if (startOk && endOk)
+            return 1;
+        p += n;
+    }
+    return 0;
+}
+
+void ModsEnv_Apply(void) {
+    static int applied = 0;
+    const char *v = getenv("LBA2_MODS_MOTOR");
+    if (!v || applied)
+        return; // aberto sem o gerenciador: tudo ligado; so na abertura do jogo
+    applied = 1;
+    SwimEnabled = HasWord(v, "swim");
+    JetFreeEnabled = HasWord(v, "jetfree");
+    PilotEnabled = HasWord(v, "pilot");
+    AlienGunEnabled = HasWord(v, "blaster");
+    WorldEnabled = HasWord(v, "world");
+    WorldStory = HasWord(v, "worldstory"); // ilhas e planetas so liberados pela historia
+    if (HasWord(v, "orbit") || HasWord(v, "followcam"))
+        Orbit_Enable(1); // camera orbital estilo GTA San Andreas
+    else
+        FollowCamera = 0;
+    LogPrintf("Mods do motor: natacao=%d jetpack=%d naves=%d camera=%d\n", (int)SwimEnabled, (int)JetFreeEnabled, (int)PilotEnabled, (int)FollowCamera);
+}
+
+static int ModsLangPT(void) {
+    const char *l = getenv("LBA2_MODS_LANG");
+    if (l AND (l[0] == 'P' OR l[0] == 'p'))
+        return 1;
+    if (l AND (l[0] == 'E' OR l[0] == 'e'))
+        return 0;
+    return Language == 5; // jogo em portugues
+}
+
+const char *Mods_Text(int id) {
+    static const char *const pt[] = {"Mar aberto", "Avance a hist\xA2ria para liberar"};
+    static const char *const en[] = {"Open sea", "Advance the story to unlock"};
+    if (id < 0 OR id > 1)
+        return "";
+    return ModsLangPT() ? pt[id] : en[id];
+}
