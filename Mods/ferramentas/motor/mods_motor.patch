diff --git a/SOURCES/ORBIT.CPP b/SOURCES/ORBIT.CPP
new file mode 100644
index 0000000..c9706d0
--- /dev/null
+++ b/SOURCES/ORBIT.CPP
@@ -0,0 +1,147 @@
+/* ORBIT.CPP - Camera Orbital (mod), no estilo do GTA San Andreas.
+ *
+ * Usa a Auto camera do port (FOLLOWCAM.CPP) com:
+ *  - mouse livre (sem segurar botao) girando e inclinando a camera, suavizado;
+ *  - a camera se ajeita sozinha atras do Twinsen (~1,5 s depois do mouse);
+ *  - (orbit_move 1: modo GTA, setas relativas a camera e camera parada)
+ *
+ *  - pilotando nave, a camera volta sozinha para tras do veiculo.
+ * So ao ar livre; dentro de casas fica a visao original.
+ */
+#include "C_EXTERN.H"
+#include "ORBIT.H"
+#include "PILOT.H"
+#include "FOLLOWCAM.H"
+#include "INPUT.H"
+#include "OBJECT.H"
+#include <SYSTEM/INPUT.H>
+#include <SYSTEM/TIMER.H>
+
+extern S32 FlagMouseCamera;
+extern S32 FlagMouseCameraDrag;
+extern S32 ManualCameraSmoothing;
+extern S32 MouseCameraSensX, MouseCameraSensY, FollowCamOrbitGlide;
+
+S32 OrbitEnabled = FALSE;
+S32 OrbitRelMove = FALSE;  // setas relativas a camera (modo GTA; desligado: camera volta sozinha)
+S32 OrbitTurnSpeed = 5000; // quao rapido o Twinsen vira para a direcao pedida (unid./s)
+
+static U32 LastTime = 0;
+
+void Orbit_Enable(S32 on) {
+    OrbitEnabled = on;
+    if (on) {
+        FollowCamera = 1;
+        FlagMouseCamera = 1;
+        FlagMouseCameraDrag = 0;   // mouse livre, como no GTA
+        ManualCameraSmoothing = 2; // mouse leve: a camera acompanha a mao (estilo GTA)
+        MouseCameraSensX = 7;
+        MouseCameraSensY = 6;
+        FollowCamOrbitGlide = 35;     // solta o mouse: para logo, sem "deslizar"
+        FollowCamReengageFrames = 150; // depois de mexer o mouse, ~2,5 s e a camera volta para tras
+    }
+}
+
+static void Orbit_Tune(void) {
+    S32 vehicle = Pilot_Active();
+    // camera se ajeita sozinha atras do heroi/veiculo (o mouse ainda gira;
+    // com orbit_move 1 volta o modo GTA: a camera fica onde o mouse deixou)
+    S32 gta = OrbitRelMove AND !vehicle;
+    FollowCamWorldAnchor = gta ? 1 : 0;
+    FollowCamHoldAngle = gta ? 1 : 0;
+    FollowCamTargetMs = vehicle ? 60 : 300; // veiculo rapido: camera nao fica para tras
+    FollowCamEaseMs = vehicle ? 350 : (gta ? 900 : 600);
+    // pousou com a camera por baixo: ela sobe sozinha ate o limite
+    if (FollowCamera AND CubeMode == CUBE_EXTERIEUR AND AlphaCam < Orbit_AlphaMin(AlphaCam)) {
+        AlphaCam += 16;
+        if (AlphaCam > Orbit_AlphaMin(AlphaCam))
+            AlphaCam = Orbit_AlphaMin(AlphaCam);
+    }
+}
+
+static S32 AngleDiff(S32 a, S32 b) {
+    S32 d = (a - b) & 4095;
+    if (d > 2048)
+        d -= 4096;
+    return d;
+}
+
+void Orbit_RemapInput(void *heroptr) {
+    T_OBJET *hero = (T_OBJET *)heroptr;
+    S32 fwd, back, left, right, dz, dx, rel, camHeading, target, diff, dt, step;
+
+    if (!OrbitEnabled)
+        return;
+    Orbit_Tune();
+    if (!OrbitRelMove OR !FollowCamera OR CubeMode != CUBE_EXTERIEUR OR CinemaMode OR Pilot_Active())
+        return;
+    if (hero->LifePoint <= 0)
+        return;
+
+    dt = LastTime ? (S32)(TimerRefHR - LastTime) : 0;
+    if (dt < 0 OR dt > 100)
+        dt = 0;
+    LastTime = TimerRefHR;
+
+    fwd = (Input & I_UP) != 0;
+    back = (Input & I_DOWN) != 0;
+    left = (Input & I_LEFT) != 0;
+    right = (Input & I_RIGHT) != 0;
+    dz = fwd - back;
+    dx = right - left;
+    if (!dz AND !dx)
+        return;
+
+    // direcao pedida em relacao a camera (virar a direita diminui o angulo)
+    if (dz > 0)
+        rel = dx > 0 ? -512 : (dx < 0 ? 512 : 0);
+    else if (dz < 0)
+        rel = dx > 0 ? -1536 : (dx < 0 ? 1536 : 2048);
+    else
+        rel = dx > 0 ? -1024 : 1024;
+
+    camHeading = (2048 - BetaCam) & 4095; // para onde a camera olha (ver FOLLOWCAM_MATH.H)
+    target = (camHeading + rel) & 4095;
+
+    diff = AngleDiff(target, hero->Obj.Beta);
+    step = OrbitTurnSpeed * dt / 1000;
+    if (step < 1)
+        step = 1;
+    if (diff > step)
+        diff = step;
+    else if (diff < -step)
+        diff = -step;
+    hero->Obj.Beta = (hero->Obj.Beta + diff) & 4095;
+    ClearRealAngle(hero);
+
+    // o motor so ve "andar para frente"; a direcao ja foi resolvida aqui
+    Input = (Input & ~(I_UP | I_DOWN | I_LEFT | I_RIGHT)) | I_UP;
+}
+
+/* Camera Orbital ao ar livre: tomadas fixas (zonas de camera) e o
+   recentralizar brusco quando o heroi some atras do cenario ficam de fora;
+   a camera so segue o heroi, sem saltos. Cenas de cinema continuam. */
+S32 Orbit_IgnoreCameraZones(S32 playerControl) {
+    return OrbitEnabled AND FollowCamera AND CubeMode == CUBE_EXTERIEUR AND !CinemaMode AND playerControl;
+}
+
+// inclinacao: ate 950 (quase de cima); para baixo, voando alto a camera
+// pode passar por baixo da nave (-380, olhando para cima); no chao ela desce
+// ate a altura do heroi (40), senao entraria no chao
+S32 Orbit_AlphaMin(S32 def) {
+    if (!OrbitEnabled OR !FollowCamera OR CubeMode != CUBE_EXTERIEUR)
+        return def;
+    return Pilot_AirHeight() > 2500 ? -380 : 40;
+}
+
+S32 Orbit_AlphaMax(S32 def) {
+    return (OrbitEnabled AND FollowCamera AND CubeMode == CUBE_EXTERIEUR) ? 950 : def;
+}
+
+S32 Orbit_MouseDeadZone(S32 def) {
+    return OrbitEnabled ? 0 : def; // sem zona morta: movimentos pequenos tambem contam
+}
+
+S32 Orbit_ThirdPerson(void) {
+    return OrbitEnabled AND FollowCamera;
+}
diff --git a/SOURCES/ORBIT.H b/SOURCES/ORBIT.H
new file mode 100644
index 0000000..240765d
--- /dev/null
+++ b/SOURCES/ORBIT.H
@@ -0,0 +1,28 @@
+/* ORBIT.H - Camera Orbital (mod), estilo GTA San Andreas. Ver ORBIT.CPP. */
+#ifndef ORBIT_H
+#define ORBIT_H
+
+#include <SYSTEM/ADELINE_TYPES.H>
+
+extern S32 OrbitEnabled;
+extern S32 OrbitRelMove;
+extern S32 OrbitTurnSpeed;
+
+void Orbit_Enable(S32 on);
+
+// Chamado em DoDir para o heroi em MOVE_MANUAL (T_OBJET *): setas relativas a camera.
+void Orbit_RemapInput(void *hero);
+
+// TRUE: camera atras do heroi/veiculo (sem a inclinacao "de cima" do voo).
+S32 Orbit_ThirdPerson(void);
+
+// TRUE: ignora zonas de camera e o recentralizar brusco (ar livre, jogador no controle).
+S32 Orbit_IgnoreCameraZones(S32 playerControl);
+
+// Mouse "leve" (estilo GTA): limites da inclinacao da camera (pode olhar de
+// baixo para cima) e zona morta do mouse.
+S32 Orbit_AlphaMin(S32 def);
+S32 Orbit_AlphaMax(S32 def);
+S32 Orbit_MouseDeadZone(S32 def);
+
+#endif
