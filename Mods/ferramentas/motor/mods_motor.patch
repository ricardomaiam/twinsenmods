diff --git a/SOURCES/PILOT.CPP b/SOURCES/PILOT.CPP
new file mode 100644
index 0000000..3c51199
--- /dev/null
+++ b/SOURCES/PILOT.CPP
@@ -0,0 +1,1466 @@
+/* PILOT.CPP - Pilotar naves e veiculos (mod). Ver PILOT.H. */
+
+#include "C_EXTERN.H"
+#include "PILOT.H"
+#include "SHIPFX.H"
+#include "MODSND.H"
+#include "JETFREE.H"
+#include "ORBIT.H"
+#include "SWIM.H"
+#include "WORLDMAP.H"
+#include "SPACE.H"
+#include "OBJECT.H"
+#include "INPUT.H"
+#include "3DEXT/MAPTOOLS.H"
+#include "INTEXT.H"
+#include "AMBIANCE.H"
+
+#include <SYSTEM/KEYBOARD.H>
+#include <SYSTEM/KEYBOARD_KEYS.H>
+#include <SYSTEM/INPUT.H>
+#include <SYSTEM/TIMER.H>
+#include <SYSTEM/LOGPRINT.H>
+#include <ANIM/ANIM.H>
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+#include <math.h>
+
+extern S32 CurrentCubeX, CurrentCubeY;
+extern U8 *IsleMapIndex;
+
+#define CUBE_SIZE   (64 * SIZE_BRICK_XZ)
+#define ESMER_FILE3D_ID 47
+#define EDGE_MARGIN 700
+#define FLOAT_ABOVE 60 // a nave fica um pouco acima do chao / da agua
+
+S32 PilotEnabled = TRUE;
+S32 PilotSpeed = 7000;
+S32 PilotMinSize = 2000;
+S32 PilotTest = 0;
+S32 PilotDbgAnim = -1; // teste: forca anim generica da nave
+S32 PilotDbgBody = -1; // teste: forca corpo generico da nave
+S32 DbgShowBody = -1;  // teste: mostra o corpo HQR N no lugar do heroi
+S32 DbgShowAnim = -1;  // teste: com a anim HQR N
+
+static S32 PilotOn = FALSE;
+static S32 PilotObj = -1;
+static S32 ShipX, ShipY, ShipZ, ShipBeta;
+static S32 ShipSize = 0;
+static S32 CurSpeed = 0;
+static U32 LastTime = 0;
+static U32 HoldFwdSince = 0;
+static S32 VWasDown = FALSE;
+static S32 HeroFlagsSaved = 0;
+/* Enquanto pilota, nem o heroi escondido nem a nave usam a colisao do motor:
+   quando ela recusa a posicao, o DoAnimExt pula o resto do frame (inclusive o
+   controle da nave). A nave tem a sua propria colisao em Pilot_HeroPos. */
+#define PILOT_COLFLAGS (CHECK_BRICK_COL | CHECK_OBJ_COL | OBJ_FALLABLE | OBJ_CARRIER)
+// OBJ_CARRIER: a nave pilotada nao "carrega" quem estava perto/encostado nela
+static S32 HeroColSaved = 0, ShipColSaved = 0;
+static T_OBJET ShipBackup;
+
+/* Movimento "de cutscene": a nave inclina ao virar e ao subir/descer. */
+static double TurnVel = 0.0; // giro atual (unidades/s), acelera e desacelera
+static double RollCur = 0.0, PitchCur = 0.0;
+static S32 ShipAirborne = FALSE;
+static S32 SavedGenBody = -1, SavedGenAnim = -1;
+static S16 SavedOffsetLife = -1, SavedOffsetTrack = -1;
+
+/* Dino-Fly: corpo com o Twinsen montado e animacao de bater asas. */
+#define DINO_GEN_BODY_RIDER 0   // corpo 166: Dino-Fly com o Twinsen nas costas
+#define DINO_GEN_ANIM_FLY   341 // anim 841: voando, batendo as asas
+
+static S32 IsDino(T_OBJET *o) {
+    S32 b = o->Obj.Body.Num;
+    return b == 166 OR b == 167 OR b == 168;
+}
+static S32 CarryPending = FALSE;
+static void VehicleSoundsEnter(T_OBJET *o);
+static void VehicleSoundsExit(T_OBJET *o);
+static S32 ParkPending = FALSE; // veiculo deixado estacionado vai para a cena nova
+
+/* Naves que voam (sobem e descem com E/Q): naves Esmer e o Dino-Fly.
+   O resto (balsa, botes, taxi) anda na superficie e nao entra em terra. */
+static S32 IsFlyer(T_OBJET *o) {
+    S32 b = o->Obj.Body.Num;
+    return IsDino(o) OR (b >= 71 AND b <= 74);
+}
+static S32 ShipFlies = TRUE;
+
+/* Portas: ao entrar fecha, ao sair abre (anims genericas do proprio veiculo).
+   Nave Esmer com porta (corpos 71, 74-77, 17 grupos): 216 = porta fechada,
+   191 = abre a porta e fica aberta. Balsa (165): 2 = rampa de tras levantada;
+   ao sair volta a anim que ela tinha (rampa abaixada). */
+typedef struct {
+    S16 body;
+    S16 closeAnim;
+    S16 openAnim; // -1: volta a anim de antes de entrar
+} T_PILOT_DOOR;
+static const T_PILOT_DOOR PilotDoors[] = {
+    {71, 216, 191}, {74, 216, 191}, {75, 216, 191}, {76, 216, 191}, {77, 216, 191},
+    {165, 2, -1},
+    {-1, 0, 0}};
+
+static const T_PILOT_DOOR *FindDoor(T_OBJET *o) {
+    S32 i;
+    for (i = 0; PilotDoors[i].body != -1; i++)
+        if (PilotDoors[i].body == o->Obj.Body.Num)
+            return &PilotDoors[i];
+    return NULL;
+}
+static S32 BoatLevel = -99999; // barco: altura fixa da linha d'agua
+/* Barco com peso (estilo GTA): a velocidade fica no mundo e o casco gira por
+   cima dela; a agua freia o deslize de lado aos poucos e o barco so vira bem
+   quando esta andando. */
+static double BoatVX = 0.0, BoatVZ = 0.0;
+static S32 BoatThrust = 0;
+static S32 GearUp = FALSE;
+static double Thrust = 0.0;    // forca do motor da nave Esmer (0..1): fogo do escapamento
+static U32 ThrustHoldSince = 0; // segurando para frente desde (turbo)
+#define DINO_MAX_ALT 13000      // o Dino-Fly nao sobe alem disso (nao vai ao espaco)
+#define DINO_MAX_ABOVE 4500     // ... nem mais que isso acima do chao, se o chao for alto
+static S32 VehAnimWant = -1; // anim virtual que o veiculo deve estar tocando (-1: nenhuma)
+
+/* Corpos grandes que nao sao veiculos (serpente do mar, maquinas do elevador). */
+static const S32 NotAShip[] = {376, 339, 340, 341, -1};
+
+S32 Pilot_Active(void) {
+    return PilotOn;
+}
+
+S32 Pilot_ShipObj(void) {
+    return PilotOn ? PilotObj : -1;
+}
+
+void Pilot_SetAltitude(S32 y) {
+    ShipY = y;
+}
+
+S32 Pilot_IsVehicle(S32 numobj) {
+    return PilotOn AND numobj == PilotObj;
+}
+
+static S32 IsExcluded(S32 body) {
+    S32 i;
+    for (i = 0; NotAShip[i] != -1; i++)
+        if (NotAShip[i] == body)
+            return TRUE;
+    return FALSE;
+}
+
+static S32 ObjSize(T_OBJET *o) {
+    S32 sx = o->XMax - o->XMin, sz = o->ZMax - o->ZMin;
+    return sx > sz ? sx : sz;
+}
+
+static S32 GroundAt(S32 x, S32 z) {
+    S32 g;
+    if (x < 0)
+        x = 0;
+    if (z < 0)
+        z = 0;
+    if (x > CUBE_SIZE - 1)
+        x = CUBE_SIZE - 1;
+    if (z > CUBE_SIZE - 1)
+        z = CUBE_SIZE - 1;
+    g = CalculAltitudeObjet(x, z, 0);
+    return g < 0 ? 0 : g; // o mar fica no Y = 0
+}
+
+static S32 HasNeighbour(S32 dx, S32 dz) {
+    S32 cx = CurrentCubeX + dx, cz = CurrentCubeY + dz;
+    if (cx < 0 OR cx > 15 OR cz < 0 OR cz > 15 OR !IsleMapIndex)
+        return FALSE;
+    return (IsleMapIndex[cz * 16 + cx] & 127) != 0;
+}
+
+/* Passa para a area vizinha (dir: 0 norte +z, 1 sul -z, 2 leste +x, 3 oeste -x)
+   usando a zona de borda da cena que leva para aquele lado. */
+static S32 CrossBorder(S32 dir) {
+    T_ZONE *z = ListZone;
+    S32 n, best = -1, bestd = 0;
+    for (n = 0; n < NbZones; n++, z++) {
+        S32 d;
+        if (z->Type != 0 OR !(TabArrow[MAX_OBJECTIF + z->Num].FlagHolo & 4))
+            continue;
+        if (dir == 0 AND z->Z1 < CUBE_SIZE - 1024)
+            continue;
+        if (dir == 1 AND z->Z0 > 1024)
+            continue;
+        if (dir == 2 AND z->X1 < CUBE_SIZE - 1024)
+            continue;
+        if (dir == 3 AND z->X0 > 1024)
+            continue;
+        d = (dir < 2) ? abs(ShipX - (z->X0 + z->X1) / 2) : abs(ShipZ - (z->Z0 + z->Z1) / 2);
+        if (best == -1 OR d < bestd) {
+            best = n;
+            bestd = d;
+        }
+    }
+    if (best == -1)
+        return FALSE;
+    NewCube = ListZone[best].Num;
+    NewPosX = ShipX;
+    NewPosZ = ShipZ;
+    NewPosY = ShipY;
+    switch (dir) {
+    case 0: NewPosZ = EDGE_MARGIN + 400; break; // chega longe da borda oposta
+    case 1: NewPosZ = CUBE_SIZE - EDGE_MARGIN - 400; break;
+    case 2: NewPosX = EDGE_MARGIN + 400; break;
+    case 3: NewPosX = CUBE_SIZE - EDGE_MARGIN - 400; break;
+    }
+    FlagReajustPosTwinsen = FALSE;
+    FlagChgCube = 1;
+    LogPrintf("Pilot: atravessando para a area %d\n", NewCube);
+    return TRUE;
+}
+
+static void TryEnter(S32 hx, S32 hz) {
+    S32 n, best = -1, bestd = 0;
+
+    for (n = 1; n < NbObjets; n++) {
+        T_OBJET *o = &ListObjet[n];
+        S32 size, d;
+        double ddx, ddz;
+        if (o->Flags & SPRITE_3D)
+            continue;
+        if (o->Obj.Body.Num == -1 OR(o->WorkFlags & OBJ_DEAD))
+            continue;
+        if (IsExcluded(o->Obj.Body.Num))
+            continue;
+        size = ObjSize(o);
+        if (size < PilotMinSize)
+            continue;
+        ddx = o->Obj.X - hx;
+        ddz = o->Obj.Z - hz;
+        d = (S32)sqrt(ddx * ddx + ddz * ddz) - size / 2;
+        if (d > 2500)
+            continue;
+        if (best == -1 OR d < bestd) {
+            best = n;
+            bestd = d;
+        }
+    }
+    if (best == -1)
+        return;
+
+    {
+        T_OBJET *o = &ListObjet[best];
+        T_OBJET *hero = &ListObjet[NUM_PERSO];
+
+        JetFree_Reset();
+        if (HeroSwimming)
+            Swim_Leave();
+
+        PilotOn = TRUE;
+        PilotObj = best;
+        ShipX = o->Obj.X;
+        ShipY = o->Obj.Y;
+        ShipZ = o->Obj.Z;
+        ShipBeta = o->Obj.Beta & 4095;
+        ShipSize = ObjSize(o);
+        ShipFlies = IsFlyer(o);
+        BoatLevel = -99999;
+        BoatVX = BoatVZ = 0.0;
+        GearUp = FALSE;
+        VehAnimWant = -1;
+        CurSpeed = 0;
+        HoldFwdSince = 0;
+        o->Move = NO_MOVE;
+        SavedGenBody = o->GenBody;
+        SavedGenAnim = o->GenAnim;
+        // o roteiro da nave (motorista, viagem automatica...) fica pausado
+        SavedOffsetLife = o->OffsetLife;
+        SavedOffsetTrack = o->OffsetTrack;
+        o->OffsetLife = -1;
+        o->OffsetTrack = -1;
+        TurnVel = 0.0;
+        RollCur = PitchCur = 0.0;
+        if (IsDino(o))
+            InitBody(DINO_GEN_BODY_RIDER, (U8)best); // Twinsen montado no Dino-Fly
+        {
+            const T_PILOT_DOOR *d = FindDoor(o);
+            if (d AND SearchAnim((U16)d->closeAnim, best) >= 0)
+                InitAnim((U16)d->closeAnim, ANIM_REPEAT, (U8)best); // fecha a porta
+        }
+        VehicleSoundsEnter(o);
+
+        HeroFlagsSaved = hero->Flags & (INVISIBLE | NO_SHADOW);
+        hero->Flags |= INVISIBLE | NO_SHADOW;
+        HeroColSaved = hero->Flags & PILOT_COLFLAGS;
+        hero->Flags &= ~PILOT_COLFLAGS;
+        ShipColSaved = o->Flags & PILOT_COLFLAGS;
+        o->Flags &= ~PILOT_COLFLAGS;
+        hero->GenAnim = (U16)-1;
+        InitAnim(GEN_ANIM_RIEN, ANIM_REPEAT, NUM_PERSO);
+        LogPrintf("Pilot: entrou no objeto %d (corpo %d, tamanho %d)\n", best, o->Obj.Body.Num, ShipSize);
+    }
+}
+
+static S32 DeadlyAt(S32 x, S32 z) {
+    S32 y = CalculAltitudeObjet(x, z, 0);
+    S32 cj;
+    cj = PtrWorldCodeBrick(x, y - 1, z) >> 4;
+    if (cj == CJ_LAVE OR cj == CJ_ANIMATED_LAVE)
+        return TRUE;
+    if (Swim_IsSwimCode(cj))
+        return !SwimEnabled; // com a natacao ligada ele sai nadando
+    return FALSE;
+}
+
+static S32 ExitSpot(S32 side, S32 *ex, S32 *ez) {
+    double a = (double)((ShipBeta + side * 1024) & 4095) * (2.0 * 3.14159265358979 / 4096.0);
+    S32 off = ShipSize / 2 + 700;
+    *ex = ShipX + (S32)(sin(a) * off);
+    *ez = ShipZ + (S32)(cos(a) * off);
+    if (*ex < EDGE_MARGIN)
+        *ex = EDGE_MARGIN;
+    if (*ez < EDGE_MARGIN)
+        *ez = EDGE_MARGIN;
+    if (*ex > CUBE_SIZE - EDGE_MARGIN)
+        *ex = CUBE_SIZE - EDGE_MARGIN;
+    if (*ez > CUBE_SIZE - EDGE_MARGIN)
+        *ez = CUBE_SIZE - EDGE_MARGIN;
+    return !DeadlyAt(*ex, *ez);
+}
+
+static void DoExit(S32 *x, S32 *y, S32 *z, S32 force) {
+    T_OBJET *hero = &ListObjet[NUM_PERSO];
+    S32 ex, ez, side;
+
+    // procura um lado seguro (direita, esquerda, frente, tras); em cima de gas
+    // ou lava nao deixa sair
+    for (side = 1; side <= 4; side++)
+        if (ExitSpot(side == 4 ? 0 : (side == 2 ? 3 : side), &ex, &ez))
+            break;
+    if (side > 4 AND force)
+        ExitSpot(1, &ex, &ez);
+    else if (side > 4) {
+        LogPrintf("Pilot: lugar perigoso para sair, continue pilotando\n");
+        return;
+    }
+
+    *x = ex;
+    *z = ez;
+    *y = CalculAltitudeObjet(ex, ez, 0); // no mar ele cai na agua e nada
+
+    hero->Flags &= ~(INVISIBLE | NO_SHADOW);
+    hero->Flags |= HeroFlagsSaved | HeroColSaved;
+    hero->WorkFlags &= ~(FALLING | CHECK_FALLING);
+    StartYFalling = 0;
+    hero->GenAnim = (U16)-1;
+    InitAnim(GEN_ANIM_RIEN, ANIM_REPEAT, NUM_PERSO);
+
+    if (PilotObj >= 0 AND PilotObj < NbObjets) {
+        T_OBJET *o = &ListObjet[PilotObj];
+        VehicleSoundsExit(o);
+        o->Obj.Alpha = 0;
+        o->Obj.Gamma = 0;
+        o->OffsetLife = SavedOffsetLife; // a nave volta a ter seu roteiro
+        o->OffsetTrack = SavedOffsetTrack;
+        o->Flags |= ShipColSaved;
+        if (IsDino(o) AND SavedGenBody >= 0) {
+            InitBody((U8)SavedGenBody, (U8)PilotObj);
+            InitAnim((U16)SavedGenAnim, ANIM_REPEAT, (U8)PilotObj);
+        } else if (VehAnimWant >= 0 AND !FindDoor(o)) {
+            // helice para / trem de pouso volta: anim que o veiculo tinha
+            if (SavedGenAnim >= 0 AND SearchAnim((U16)SavedGenAnim, PilotObj) >= 0) {
+                o->GenAnim = (U16)-1;
+                InitAnim((U16)SavedGenAnim, ANIM_REPEAT, (U8)PilotObj);
+            }
+        } else {
+            const T_PILOT_DOOR *d = FindDoor(o);
+            if (d) { // abre a porta
+                S32 open = d->openAnim >= 0 ? d->openAnim : SavedGenAnim;
+                if (open >= 0 AND SearchAnim((U16)open, PilotObj) >= 0) {
+                    o->GenAnim = (U16)-1;
+                    InitAnim((U16)open, ANIM_REPEAT, (U8)PilotObj);
+                }
+            }
+        }
+    }
+
+    // voou por areas de ilha sem recarregar: agora carrega a cena de onde ele
+    // desceu, levando o veiculo estacionado junto
+    if (World_Deferred() AND PilotObj >= 0 AND PilotObj < NbObjets) {
+        memcpy(&ShipBackup, &ListObjet[PilotObj], sizeof(T_OBJET));
+        ParkPending = TRUE;
+        World_FlushDeferred(*x, *y, *z);
+    }
+
+    PilotOn = FALSE;
+    PilotObj = -1;
+    VehAnimWant = -1;
+    GearUp = FALSE;
+    NumObjFollow = NUM_PERSO;
+    Fly_SetView(FALSE, 0, 0);
+    FlyExtraDist = 0;
+    LogPrintf("Pilot: saiu da nave\n");
+}
+
+void Pilot_HeroPos(S32 *x, S32 *y, S32 *z) {
+    T_OBJET *hero = &ListObjet[NUM_PERSO];
+    S32 vdown, edge, dt, fwd, back, turn, strafe, vert, target, step, ground, oldSX, oldSZ;
+    double a;
+
+    if (DbgShowBody >= 0) {
+        hero->Obj.Body.Num = DbgShowBody;
+        if (DbgShowAnim >= 0 AND hero->Obj.Anim.Num != DbgShowAnim)
+            ObjectInitAnim(&hero->Obj, (void *)(uintptr_t)(U32)DbgShowAnim);
+    }
+
+    vdown = CheckKey(K_V) OR(PilotTest & 1);
+    edge = vdown AND !VWasDown;
+    VWasDown = vdown;
+
+    dt = LastTime ? (S32)(TimerRefHR - LastTime) : 0;
+    if (dt < 0 OR dt > 100)
+        dt = 0;
+    LastTime = TimerRefHR;
+
+    if (!PilotOn) {
+        if (edge AND PilotEnabled AND CubeMode == CUBE_EXTERIEUR)
+            TryEnter(hero->Obj.X, hero->Obj.Z);
+        if (!PilotOn)
+            return;
+    } else if (edge AND !Space_Active()) { // no espaco nao da para sair
+        DoExit(x, y, z, FALSE);
+        if (!PilotOn)
+            return;
+    }
+
+    if (PilotObj < 0 OR PilotObj >= NbObjets OR ListObjet[PilotObj].Obj.Body.Num == -1) {
+        DoExit(x, y, z, TRUE);
+        return;
+    }
+
+    hero->Flags |= INVISIBLE | NO_SHADOW;
+    hero->Flags &= ~PILOT_COLFLAGS;
+    hero->ObjCol = -1; // dentro da nave nao "encosta" em ninguem (scripts de colisao)
+    CameraZone = FALSE; // camera segue a nave (zonas de camera fixa nao valem)
+    FlagCameraForcee = FALSE;
+    if (PilotObj >= 0)
+        NumObjFollow = (U8)PilotObj;
+
+    fwd = (Input & I_UP) != 0;
+    back = (Input & I_DOWN) != 0;
+    turn = ((Input & I_RIGHT) ? 1 : 0) - ((Input & I_LEFT) ? 1 : 0);
+    strafe = ((CheckKey(K_D) OR(PilotTest & 16)) ? 1 : 0) - ((CheckKey(K_A) OR(PilotTest & 8)) ? 1 : 0);
+    vert = ((CheckKey(K_E) OR(PilotTest & 2)) ? 1 : 0) - ((CheckKey(K_Q) OR(PilotTest & 4)) ? 1 : 0);
+
+    // motor da nave: acende ao acelerar, maior no turbo, apaga aos poucos
+    {
+        double want, k = dt * (fwd ? 5.0 : 3.0) / 1000.0;
+        if (fwd) {
+            if (!ThrustHoldSince)
+                ThrustHoldSince = TimerRefHR;
+        } else
+            ThrustHoldSince = 0;
+        want = !fwd ? 0.0 : (TimerRefHR - ThrustHoldSince > 2000 ? 1.0 : 0.65);
+        if (vert AND want < 0.55)
+            want = 0.55; // subindo ou descendo (E/Q): o motor tambem trabalha
+        if (!ShipFlies OR !GearUp)
+            want = 0.0;
+        if (k > 1.0)
+            k = 1.0;
+        Thrust += (want - Thrust) * k;
+    }
+
+    // mini espaco: a nave voa la; aqui ela fica parada no alto (cena nao desenhada)
+    if (Space_Active()) {
+        Space_Update(dt, fwd, back, turn, vert);
+        *x = ShipX;
+        *y = ShipY;
+        *z = ShipZ;
+        hero->WorkFlags &= ~(FALLING | CHECK_FALLING);
+        StartYFalling = 0;
+        return;
+    }
+
+    if (!ShipFlies) {
+        // ---------------- barco ----------------
+        double h, hx, hz, f, l, tgt, acc, spdAbs, turnMax, want, k, dts = dt / 1000.0;
+        if (fwd) {
+            if (!HoldFwdSince)
+                HoldFwdSince = TimerRefHR;
+        } else
+            HoldFwdSince = 0;
+        tgt = fwd ? PilotSpeed : (back ? -PilotSpeed / 2 : 0);
+        if (fwd AND HoldFwdSince AND TimerRefHR - HoldFwdSince > 2000)
+            tgt *= 2;
+
+        // decompoe a velocidade no casco atual
+        h = (double)ShipBeta * (2.0 * 3.14159265358979 / 4096.0);
+        hx = sin(h);
+        hz = cos(h);
+        f = BoatVX * hx + BoatVZ * hz;  // para frente
+        l = BoatVX * hz - BoatVZ * hx;  // de lado
+
+        // motor e arrasto da agua
+        if (fwd OR back) {
+            acc = (tgt > f ? 5500.0 : 4000.0) * dts;
+            if (f < tgt) { f += acc; if (f > tgt) f = tgt; }
+            else if (f > tgt) { f -= acc; if (f < tgt) f = tgt; }
+        } else
+            f *= exp(-0.9 * dts); // sem motor: desliza ate parar (~2 s)
+        l *= exp(-2.6 * dts);     // a agua segura o deslize de lado
+        BoatThrust = fwd AND f < tgt * 0.85;
+
+        // leme: vira pouco parado, bem andando; de re, inverte
+        spdAbs = f < 0 ? -f : f;
+        turnMax = 1150.0 * (0.25 + 0.75 * (spdAbs > PilotSpeed ? 1.0 : spdAbs / PilotSpeed));
+        want = -turn * turnMax * (f < -300.0 ? -1.0 : 1.0);
+        k = (turn ? 5.0 : 8.0) * dts; // solta a tecla: o giro para logo
+        if (k > 1.0) k = 1.0;
+        TurnVel += (want - TurnVel) * k;
+        ShipBeta = (ShipBeta + (S32)(TurnVel * dts)) & 4095;
+
+        // recomp�e no mundo (o casco ja girou; a velocidade nao: carving)
+        BoatVX = f * hx + l * hz;
+        BoatVZ = f * hz - l * hx;
+        CurSpeed = (S32)f;
+
+        a = (double)ShipBeta * (2.0 * 3.14159265358979 / 4096.0);
+        oldSX = ShipX;
+        oldSZ = ShipZ;
+        ShipX += (S32)(BoatVX * dts);
+        ShipZ += (S32)(BoatVZ * dts);
+    } else {
+    // velocidade com aceleracao; segurando para frente por 2 s, turbo
+        if (fwd) {
+            if (!HoldFwdSince)
+                HoldFwdSince = TimerRefHR;
+        } else
+            HoldFwdSince = 0;
+        target = fwd ? PilotSpeed : (back ? -PilotSpeed / 2 : 0);
+        if (fwd AND HoldFwdSince AND TimerRefHR - HoldFwdSince > 2000)
+            target *= 2;
+        step = 9000 * dt / 1000;
+        if (CurSpeed < target) {
+            CurSpeed += step;
+            if (CurSpeed > target)
+                CurSpeed = target;
+        } else if (CurSpeed > target) {
+            CurSpeed -= step;
+            if (CurSpeed < target)
+                CurSpeed = target;
+        }
+
+        // giro com aceleracao (sem tranco) e inclinacao suave para o lado
+        {
+            double want = -turn * 1400.0, k = dt * 4.0 / 1000.0;
+            if (k > 1.0)
+                k = 1.0;
+            TurnVel += (want - TurnVel) * k;
+            ShipBeta = (ShipBeta + (S32)(TurnVel * dt / 1000.0)) & 4095;
+        }
+
+        a = (double)ShipBeta * (2.0 * 3.14159265358979 / 4096.0);
+        oldSX = ShipX;
+        oldSZ = ShipZ;
+        ShipX += (S32)(sin(a) * CurSpeed * dt / 1000.0);
+        ShipZ += (S32)(cos(a) * CurSpeed * dt / 1000.0);
+        if (strafe) {
+            double b = a + 3.14159265358979 / 2.0;
+            ShipX += (S32)(sin(b) * strafe * PilotSpeed / 2 * dt / 1000.0);
+            ShipZ += (S32)(cos(b) * strafe * PilotSpeed / 2 * dt / 1000.0);
+        }
+    }
+
+    if (!ShipFlies)
+        vert = 0; // barco: sempre na superficie
+    ShipY += vert * 3500 * dt / 1000;
+    if (PilotObj >= 0 AND IsDino(&ListObjet[PilotObj])) { // Dino-Fly: teto de voo
+        S32 g = GroundAt(ShipX, ShipZ), top = DINO_MAX_ALT;
+        if (g + DINO_MAX_ABOVE > top)
+            top = g + DINO_MAX_ABOVE;
+        if (ShipY > top)
+            ShipY = top;
+    }
+    if (ShipFlies AND vert > 0 AND ShipY > SPACE_ENTER_ALT AND PilotObj >= 0
+            AND ListObjet[PilotObj].IndexFile3D == ESMER_FILE3D_ID)
+        Space_TryEnter(PilotObj); // subiu demais: espaco
+
+    // barco nao sobe em terra: chao acima da linha d'agua e parede
+    if (!ShipFlies AND BoatLevel != -99999 AND (ShipX != oldSX OR ShipZ != oldSZ)
+            AND CalculAltitudeObjet(ShipX, ShipZ, 0) > BoatLevel
+            AND CalculAltitudeObjet(oldSX, oldSZ, 0) <= BoatLevel) {
+        if (CalculAltitudeObjet(ShipX, oldSZ, 0) <= BoatLevel)
+            ShipZ = oldSZ;
+        else if (CalculAltitudeObjet(oldSX, ShipZ, 0) <= BoatLevel)
+            ShipX = oldSX;
+        else {
+            ShipX = oldSX;
+            ShipZ = oldSZ;
+        }
+        CurSpeed = CurSpeed / 2;
+    }
+
+    // batida em construcoes/objetos do cenario: desliza junto da parede ou para,
+    // nunca prende (se ja estava dentro de algo, deixa sair)
+    if ((ShipX != oldSX OR ShipZ != oldSZ) AND !PtrWorldColBrick(oldSX, ShipY + 300, oldSZ)
+            AND PtrWorldColBrick(ShipX, ShipY + 300, ShipZ)) {
+        if (!PtrWorldColBrick(ShipX, ShipY + 300, oldSZ))
+            ShipZ = oldSZ;
+        else if (!PtrWorldColBrick(oldSX, ShipY + 300, ShipZ))
+            ShipX = oldSX;
+        else {
+            ShipX = oldSX;
+            ShipZ = oldSZ;
+        }
+        CurSpeed = CurSpeed / 2; // perde velocidade na batida
+    }
+
+    World_DomeBlock(&ShipX, ShipY, &ShipZ); // modo historia: cupula da ilha bloqueada
+
+    // bordas: se existe area vizinha naquele lado, passa para ela; senao, parede
+    {
+        S32 lo = EDGE_MARGIN, hi = CUBE_SIZE - EDGE_MARGIN;
+        if (World_Active()) {
+            // mapa aberto: qualquer borda leva para a area/mar/ilha vizinha
+            // passa na borda verdadeira e continua exatamente do outro lado
+            // (mesma posicao no mundo: a nave e a camera nao dao salto)
+            S32 wdx = ShipX >= CUBE_SIZE ? 1 : (ShipX < 0 ? -1 : 0);
+            S32 wdz = ShipZ >= CUBE_SIZE ? 1 : (ShipZ < 0 ? -1 : 0);
+            S32 r = WORLD_CROSS;
+            if ((wdx OR wdz) AND NewCube == -1)
+                r = World_Cross(wdx, wdz, ShipX - wdx * CUBE_SIZE, ShipY, ShipZ - wdz * CUBE_SIZE, -1);
+            if (r == WORLD_CROSS AND World_TookInPlace()) { // mar -> mar, sem trocar de cena
+                ShipX -= wdx * CUBE_SIZE;
+                ShipZ -= wdz * CUBE_SIZE;
+                oldSX -= wdx * CUBE_SIZE;
+                oldSZ -= wdz * CUBE_SIZE;
+            }
+            if (r == WORLD_CROSS) {
+                if (ShipX < 0) ShipX = 0;
+                if (ShipZ < 0) ShipZ = 0;
+                if (ShipX > CUBE_SIZE - 1) ShipX = CUBE_SIZE - 1;
+                if (ShipZ > CUBE_SIZE - 1) ShipZ = CUBE_SIZE - 1;
+            } else { // fim do mapa: parede
+                if (ShipX > hi) ShipX = hi;
+                if (ShipX < lo) ShipX = lo;
+                if (ShipZ > hi) ShipZ = hi;
+                if (ShipZ < lo) ShipZ = lo;
+            }
+        } else {
+        if (ShipZ > hi) {
+            ShipZ = hi;
+            if (NewCube == -1 AND HasNeighbour(0, 1))
+                CrossBorder(0);
+        }
+        if (ShipZ < lo) {
+            ShipZ = lo;
+            if (NewCube == -1 AND HasNeighbour(0, -1))
+                CrossBorder(1);
+        }
+        if (ShipX > hi) {
+            ShipX = hi;
+            if (NewCube == -1 AND HasNeighbour(1, 0))
+                CrossBorder(2);
+        }
+        if (ShipX < lo) {
+            ShipX = lo;
+            if (NewCube == -1 AND HasNeighbour(-1, 0))
+                CrossBorder(3);
+        }
+        }
+    }
+
+    if (!ShipFlies) { // batida: perde a velocidade naquele eixo
+        if (ShipX == oldSX AND BoatVX != 0.0)
+            BoatVX *= -0.15;
+        if (ShipZ == oldSZ AND BoatVZ != 0.0)
+            BoatVZ *= -0.15;
+    }
+
+    ground = GroundAt(ShipX, ShipZ);
+    if (ShipY < ground + FLOAT_ABOVE)
+        ShipY = ground + FLOAT_ABOVE;
+    if (!ShipFlies) {
+        if (BoatLevel == -99999)
+            BoatLevel = ShipY; // primeira vez: onde ele estava boiando
+        ShipY = BoatLevel;
+    }
+    ShipAirborne = (ShipY > ground + 400) OR CurSpeed != 0;
+
+    // inclinacao: rola para o lado da curva (mais forte com velocidade) e
+    // empina/abaixa o nariz ao subir/descer
+    {
+        double spd = CurSpeed < 0 ? -CurSpeed : CurSpeed;
+        double rollWant = -TurnVel / 1400.0 * (180.0 + 220.0 * spd / (PilotSpeed > 0 ? PilotSpeed : 1));
+        if (!ShipFlies)
+            rollWant *= 0.35; // barco so aderna um pouco
+        if (rollWant > 380.0) rollWant = 380.0;
+        if (rollWant < -380.0) rollWant = -380.0;
+        double pitchWant = ShipFlies ? -vert * 140.0 : (BoatThrust ? -55.0 : 0.0); // barco: proa sobe ao acelerar
+        double k = dt * (ShipFlies ? 3.0 : 1.5) / 1000.0;
+        if (k > 1.0)
+            k = 1.0;
+        RollCur += (rollWant - RollCur) * k;
+        PitchCur += (pitchWant - PitchCur) * k;
+    }
+
+    *x = ShipX;
+    *y = ShipY;
+    *z = ShipZ;
+    hero->Obj.Beta = ShipBeta;
+    hero->WorkFlags &= ~(FALLING | CHECK_FALLING);
+    StartYFalling = 0;
+
+    Fly_SetView(TRUE, ShipY, ground);
+    FlyExtraDist = Orbit_ThirdPerson() ? ShipSize / 2 : ShipSize * 2;
+    memcpy(&ShipBackup, &ListObjet[PilotObj], sizeof(T_OBJET));
+}
+
+/* ------------------------------------------------------------------------
+   Animacoes feitas aqui (indices virtuais, fora do ANIM.HQR):
+   - nave Esmer (File3D 47): recolher / baixar o trem de pouso e "recolhido";
+   - balao de Otringal (File3D 193): helice girando.
+   ------------------------------------------------------------------------ */
+#define PILOT_ANIM_BASE 0x7E80
+enum {
+    PA_GEAR15_UP, PA_GEAR15_DOWN, PA_GEAR15_HOLD,
+    PA_GEAR17_UP, PA_GEAR17_DOWN, PA_GEAR17_HOLD,
+    PA_PROP,
+    PA_COUNT
+};
+static U8 *PilotAnims[PA_COUNT];
+static S32 PilotAnimsBuilt = FALSE;
+
+#define ESMER_FILE3D   47
+#define BALLOON_FILE3D 193
+#define ESMER_ANIM_TAKEOFF 426 // decolagem: pernas dobrando (ultimo quadro = recolhido)
+#define ESMER_ANIM_REST17  422 // pose parada, 17 grupos (com porta)
+#define BALLOON_ANIM_IDLE  1314
+#define GEAR_MS 900
+
+static U16 Rd16u(const U8 *p) { return (U16)(p[0] | (p[1] << 8)); }
+static void Wr16u(U8 *p, S32 v) {
+    p[0] = (U8)v;
+    p[1] = (U8)(v >> 8);
+}
+static U8 *NewAnim(S32 nf, S32 ng, S32 loop) {
+    U8 *a = (U8 *)calloc(1, 8 + nf * (8 + ng * 8));
+    if (a) {
+        Wr16u(a, nf);
+        Wr16u(a + 2, ng);
+        Wr16u(a + 4, loop);
+    }
+    return a;
+}
+static U8 *Frame(U8 *a, S32 f) { return a + 8 + f * (8 + Rd16u(a + 2) * 8); }
+
+// copia os grupos de um quadro de outra anim (ate o menor numero de grupos)
+static void CopyGroups(U8 *dst, S32 dstNg, const U8 *src, S32 srcNg) {
+    S32 n = dstNg < srcNg ? dstNg : srcNg;
+    memcpy(dst + 8, src + 8, n * 8);
+}
+
+static void BuildPilotAnims(void) {
+    const U8 *tk, *rest, *bi;
+    S32 tkNf, tkNg;
+    U8 ext15[8 + 15 * 8], up15[8 + 15 * 8], ext17[8 + 17 * 8], up17[8 + 17 * 8];
+    S32 i;
+
+    PilotAnimsBuilt = TRUE;
+    memset(PilotAnims, 0, sizeof(PilotAnims));
+    tk = (const U8 *)HQR_Get(HQR_Anims, ESMER_ANIM_TAKEOFF);
+    rest = (const U8 *)HQR_Get(HQR_Anims, ESMER_ANIM_REST17);
+    if (tk AND rest AND Rd16u(tk + 2) == 15 AND Rd16u(rest + 2) == 17) {
+        tkNf = Rd16u(tk);
+        tkNg = 15;
+        memset(ext15, 0, sizeof(ext15));
+        memset(up15, 0, sizeof(up15));
+        CopyGroups(ext15, 15, tk + 8, tkNg);                                // primeiro quadro: pernas baixadas
+        CopyGroups(up15, 15, tk + 8 + (tkNf - 1) * (8 + tkNg * 8), tkNg);  // ultimo: recolhidas
+        memset(ext17, 0, sizeof(ext17));
+        CopyGroups(ext17, 17, rest + 8, 17);
+        Wr16u(ext17 + 8 + 15 * 8 + 6, 80);   // porta fechada
+        Wr16u(ext17 + 8 + 16 * 8 + 6, 4000);
+        memcpy(up17, ext17, sizeof(up17));
+        CopyGroups(up17, 15, up15, 15);
+
+        for (i = 0; i < 2; i++) {
+            S32 ng = i ? 17 : 15;
+            U8 *e = i ? ext17 : ext15, *u = i ? up17 : up15;
+            S32 base = i ? PA_GEAR17_UP : PA_GEAR15_UP;
+            U8 *a;
+            S32 sz = 8 + ng * 8;
+            a = NewAnim(2, ng, 1); // recolher
+            if (a) {
+                memcpy(Frame(a, 0), e, sz);
+                memcpy(Frame(a, 1), u, sz);
+                Wr16u(Frame(a, 0), GEAR_MS);
+                Wr16u(Frame(a, 1), 1000);
+            }
+            PilotAnims[base] = a;
+            a = NewAnim(2, ng, 1); // baixar
+            if (a) {
+                memcpy(Frame(a, 0), u, sz);
+                memcpy(Frame(a, 1), e, sz);
+                Wr16u(Frame(a, 0), GEAR_MS);
+                Wr16u(Frame(a, 1), 1000);
+            }
+            PilotAnims[base + 1] = a;
+            a = NewAnim(1, ng, 0); // recolhido parado
+            if (a) {
+                memcpy(Frame(a, 0), u, sz);
+                Wr16u(Frame(a, 0), 1000);
+            }
+            PilotAnims[base + 2] = a;
+        }
+    }
+
+    // helice do balao: grupo 4 gira em volta do eixo do balao (gamma)
+    bi = (const U8 *)HQR_Get(HQR_Anims, BALLOON_ANIM_IDLE);
+    if (bi) {
+        S32 ng = Rd16u(bi + 2), f;
+        U8 *a = NewAnim(8, ng, 0);
+        if (a AND ng > 4) {
+            for (f = 0; f < 8; f++) {
+                U8 *fr = Frame(a, f);
+                memcpy(fr, bi + 8, 8 + ng * 8);
+                Wr16u(fr, 45); // ms por quadro: ~2,8 voltas por segundo
+                Wr16u(fr + 2, 0);
+                Wr16u(fr + 4, 0);
+                Wr16u(fr + 6, 0);
+                Wr16u(fr + 8 + 4 * 8 + 6, (f * 512) & 4095);
+            }
+        }
+        PilotAnims[PA_PROP] = a;
+    }
+}
+
+void *Pilot_GetAnim(S32 index) {
+    S32 slot = index - PILOT_ANIM_BASE;
+    if (slot < 0 OR slot >= PA_COUNT)
+        return NULL;
+    if (!PilotAnimsBuilt)
+        BuildPilotAnims();
+    if (!PilotAnims[slot])
+        return HQR_Get(HQR_Anims, 0);
+    return PilotAnims[slot];
+}
+
+
+static void ApplyVehAnim(T_OBJET *o, S32 slot) {
+    if (!PilotAnimsBuilt)
+        BuildPilotAnims();
+    if (!PilotAnims[slot])
+        return;
+    ObjectInitAnim(&o->Obj, (void *)(uintptr_t)(U32)(PILOT_ANIM_BASE + slot));
+    o->PtrAnimAction = 0;
+    o->FlagAnim = ANIM_REPEAT;
+}
+
+static S32 GearSlot(T_OBJET *o, S32 kind) { // kind 0 up, 1 down, 2 hold
+    S32 b = o->Obj.Body.Num;
+    S32 has17 = (b == 71 OR (b >= 74 AND b <= 77));
+    return (has17 ? PA_GEAR17_UP : PA_GEAR15_UP) + kind;
+}
+
+// por frame: trem de pouso da nave Esmer e helice do balao
+static void VehicleAnims(T_OBJET *o, S32 numobj) {
+    (void)numobj;
+    if (o->IndexFile3D == ESMER_FILE3D AND !IsDino(o)) {
+        S32 hgt = ShipY - GroundAt(ShipX, ShipZ);
+        if (!GearUp AND hgt > 900) {
+            GearUp = TRUE;
+            VehAnimWant = GearSlot(o, 0);
+            ApplyVehAnim(o, VehAnimWant);
+        } else if (GearUp AND hgt < 500) {
+            GearUp = FALSE;
+            VehAnimWant = GearSlot(o, 1);
+            ApplyVehAnim(o, VehAnimWant);
+        }
+    } else if (o->IndexFile3D == BALLOON_FILE3D) {
+        VehAnimWant = PA_PROP;
+    }
+    // depois de trocar de cena a nave foi recriada com a anim original: refaz
+    if (VehAnimWant >= 0 AND o->Obj.Anim.Num != PILOT_ANIM_BASE + VehAnimWant) {
+        if (VehAnimWant == GearSlot(o, 0))
+            VehAnimWant = GearSlot(o, 2); // ja estava recolhido
+        ApplyVehAnim(o, VehAnimWant);
+    }
+}
+
+/* ------------------------------------------------------------------------
+   Sons dos veiculos (os mesmos que as animacoes originais tocam):
+   - nave Esmer: decolagem 150/149/151, voo 146 a cada 2 s, pouso 146;
+   - taxi (bote): motor 107 em loop + espuma 268 andando;
+   - balsa: buzina 231 ao partir (o motor 107 vem da anim de viagem);
+   - balao: 268 com a helice girando.
+   ------------------------------------------------------------------------ */
+#define TAXI_FILE3D  197
+#define FERRY_FILE3D 108
+
+static U32 EngineSample = 0;    // loop do motor tocando
+S32 PilotFlySample = MODSND_ESMER_FLY; // cvar "pilot_flysnd": som do voo da nave Esmer (o jato do video dela; -1 = nenhum)
+static U32 NextSoundAt = 0;     // proximo som periodico
+static U32 TakeoffSecondAt = 0; // segundo som da decolagem
+static S32 PrevGearUp = FALSE;
+static S32 DinoLastFrame = -1;
+
+static void PlaySfx(S32 sample, S32 vol, S32 freq, S32 decal) {
+    if (WorldDbg)
+        LogPrintf("Pilot: som %d vol %d freq %d\n", sample, vol, freq);
+    ParmSampleVolume = (U32)vol;
+    HQ_3D_MixSample(sample, freq, decal, 1, ShipX, ShipY, ShipZ);
+}
+
+static void StopEngine(void) {
+    if (EngineSample) {
+        HQ_StopOneSample(EngineSample);
+        EngineSample = 0;
+    }
+}
+
+static U32 EngineRetryAt = 0;
+
+static void StartEngine(S32 sample, S32 vol, S32 freq) {
+    if (EngineSample AND IsSamplePlaying(EngineSample)) {
+        HQ_3D_ChangePanSample(EngineSample, ShipX, ShipY, ShipZ);
+        return;
+    }
+    if (TimerRefHR < EngineRetryAt)
+        return; // sem som (ou acabou de tentar): nao insiste a cada quadro
+    EngineRetryAt = TimerRefHR + 2000;
+    if (WorldDbg)
+        LogPrintf("Pilot: motor %d vol %d freq %d\n", sample, vol, freq);
+    ParmSampleVolume = (U32)vol;
+    EngineSample = HQ_3D_MixSample(sample, freq, 0, 0, ShipX, ShipY, ShipZ); // 0 = repete sempre
+}
+
+static void VehicleSounds(T_OBJET *o) {
+    U32 now = TimerRefHR;
+    S32 spd = CurSpeed < 0 ? -CurSpeed : CurSpeed;
+
+    if (o->IndexFile3D == ESMER_FILE3D AND !IsDino(o)) {
+        if (GearUp AND !PrevGearUp) { // decolou
+            PlaySfx(150, 20, 2998, 0);
+            TakeoffSecondAt = now + 350;
+            NextSoundAt = now + 1200;
+        } else if (!GearUp AND PrevGearUp) { // pousou
+            PlaySfx(146, 90, 5500, 0);
+            StopEngine();
+        }
+        // em voo: o jato da nave tirado do video dela no espaco, um pouco
+        // mais agudo com a velocidade e o motor
+        if (Space_Active()) // no espaco (vacuo) nao se ouve o motor
+            StopEngine();
+        else if (GearUp AND PilotFlySample >= 0 AND !TakeoffSecondAt) {
+            StartEngine(PilotFlySample, 75, 3700);
+            if (EngineSample AND IsSamplePlaying(EngineSample)) {
+                S32 ref = PilotSpeed * 2 > 0 ? PilotSpeed * 2 : 1;
+                S32 pitch = 3700 + 700 * (spd > ref ? ref : spd) / ref + (S32)(500.0 * Thrust);
+                ChangePitchbendSample(EngineSample, pitch);
+            }
+        }
+        if (TakeoffSecondAt AND now >= TakeoffSecondAt) {
+            PlaySfx(149, 127, 4096, 0);
+            PlaySfx(151, 30, 3497, 0);
+            TakeoffSecondAt = 0;
+        }
+    } else if (o->IndexFile3D == TAXI_FILE3D) {
+        StartEngine(107, 30, 3000);
+        if (spd > 600 AND now >= NextSoundAt) {
+            PlaySfx(268, 5, 2400 + (now & 127), (now & 1) ? 200 : 0);
+            NextSoundAt = now + 260;
+        }
+    } else if (IsDino(o)) {
+        // Dino-Fly no ar: as batidas de asa da anim de voo (841), audiveis
+        // (na anim elas vem quase mudas, volume 10)
+        if (ShipAirborne AND o->Obj.Anim.Num == 841) {
+            S32 f = o->Obj.LastFrame;
+            if (f != DinoLastFrame) {
+                if (f == 7 OR f == 22)
+                    PlaySfx(340, 90, 3198 + (now & 255), 300);
+                else if (f == 1 OR f == 10 OR f == 19)
+                    PlaySfx(268, 45, 3497 + (now & 127), 200);
+                DinoLastFrame = f;
+            }
+        } else
+            DinoLastFrame = -1;
+    } else if (o->IndexFile3D == BALLOON_FILE3D) {
+        if (now >= NextSoundAt) {
+            PlaySfx(268, 20, 2800 + (now & 255) + (spd > 600 ? 200 : 0), 150);
+            NextSoundAt = now + 320;
+        }
+    } else if (o->IndexFile3D == FERRY_FILE3D) {
+        if (o->SampleAlways AND IsSamplePlaying(o->SampleAlways))
+            HQ_3D_ChangePanSample(o->SampleAlways, ShipX, ShipY, ShipZ); // motor da anim de viagem
+        else
+            StartEngine(107, 70, 2000);
+    }
+    PrevGearUp = GearUp;
+}
+
+// ao entrar: som de partida
+static void VehicleSoundsEnter(T_OBJET *o) {
+    StopEngine();
+    EngineRetryAt = 0;
+    NextSoundAt = TimerRefHR + 300;
+    TakeoffSecondAt = 0;
+    PrevGearUp = FALSE;
+    if (o->IndexFile3D == FERRY_FILE3D)
+        PlaySfx(231, 10, 4997, 0); // buzina da balsa
+}
+
+// ao sair: motor para
+static void VehicleSoundsExit(T_OBJET *o) {
+    StopEngine();
+    TakeoffSecondAt = 0;
+    if (o AND o->SampleAlways) {
+        HQ_StopOneSample(o->SampleAlways);
+        o->SampleAlways = 0;
+    }
+}
+
+void Pilot_ObjPos(S32 numobj, S32 *x, S32 *y, S32 *z) {
+    T_OBJET *o;
+    if (!PilotOn OR numobj != PilotObj)
+        return;
+    o = &ListObjet[numobj];
+    VehicleAnims(o, numobj);
+    VehicleSounds(o);
+    *x = ShipX;
+    *y = ShipY;
+    *z = ShipZ;
+    o->Obj.Beta = ShipBeta;
+    o->Obj.Gamma = ((S32)RollCur) & 4095;
+    o->Obj.Alpha = ((S32)PitchCur) & 4095;
+    o->WorkFlags &= ~(FALLING | CHECK_FALLING);
+    o->ObjCol = -1;
+    o->Flags &= ~PILOT_COLFLAGS;
+    {   // ninguem fica preso a nave (barqueiro, barco vizinho...)
+        S32 k;
+        for (k = 1; k < NbObjets; k++)
+            if (k != numobj AND ListObjet[k].CarryBy == numobj)
+                ListObjet[k].CarryBy = -1;
+    }
+    ListObjet[NUM_PERSO].ObjCol = -1;
+    if (IsDino(o) AND PilotDbgAnim < 0) {
+        S32 want = ShipAirborne ? DINO_GEN_ANIM_FLY : SavedGenAnim;
+        if (want >= 0 AND o->GenAnim != want)
+            InitAnim((U16)want, ANIM_REPEAT, (U8)numobj);
+    }
+    if (PilotDbgBody >= 0 AND o->GenBody != PilotDbgBody)
+        InitBody((U8)PilotDbgBody, (U8)numobj);
+    if (PilotDbgAnim >= 0 AND o->GenAnim != PilotDbgAnim)
+        InitAnim((U16)PilotDbgAnim, ANIM_REPEAT, (U8)numobj);
+}
