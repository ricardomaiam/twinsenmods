+/* Troca de area sem ChangeCube: todos os atores, zonas, trilhas, a camera e o
+   terreno passam a contar a partir da area nova. O chamador poe o heroi (ou a
+   nave) na posicao nova. */
+static void ShiftSea(S32 dx, S32 dz, S32 owner, S32 lx, S32 lz) {
+    S32 sx = -dx * 32768, sz = -dz * 32768, n;
+    T_OBJET *o = ListObjet;
+
+    for (n = 0; n < NbObjets; n++, o++) {
+        o->Obj.X += sx;
+        o->Obj.Z += sz;
+        o->OldPosX += sx;
+        o->OldPosZ += sz;
+    }
+    {
+        T_ZONE *pz = ListZone;
+        for (n = 0; n < NbZones; n++, pz++) {
+            pz->X0 += sx;
+            pz->X1 += sx;
+            pz->Z0 += sz;
+            pz->Z1 += sz;
+        }
+    }
+    for (n = 0; n < NbBrickTrack; n++) {
+        ListBrickTrack[n].X += sx;
+        ListBrickTrack[n].Z += sz;
+    }
+    Pilot_ShiftWorld(sx, sz);
+
+    VueOffsetX += sx;
+    VueOffsetZ += sz;
+    StartXCube = VueOffsetX / SIZE_BRICK_XZ;
+    StartZCube = VueOffsetZ / SIZE_BRICK_XZ;
+    FollowCamShiftWorld(sx, 0, sz);
+
+    CurrentCubeX = lx;
+    CurrentCubeY = lz;
+    if (owner != Island OR LastIsland != owner) {
+        S32 memo = NumCube;
+        Island = PhantomIsland = owner;
+        NumCube = NUM_CUBE_PHANTOM;
+        PtrInitGrille(NUM_CUBE_PHANTOM); // carrega a ilha (texturas, paleta do ceu/mar)
+        NumCube = memo;
+        ChoicePalette();
+        FlagPal = TRUE;
+        Planet = TabArrow[Island].Planet;
+    }
+    PhantomIsland = Island;
+    // terreno da area atual (area de ilha: o cubo dela; mar: agua lisa)
+    if (LoadCube(CurrentCubeX, CurrentCubeY))
+        FixeObjetsDecorsInvisibles();
+    else
+        InitSeaCube();
+    FollowCamSetView();
+}
+
+S32 World_Cross(S32 dx, S32 dz, S32 x, S32 y, S32 z, S32 inset) {
+    S32 isl, g, wx, wz, tisl, tcx, tcy, scene;
+
+    if (!World_Active() OR (!dx AND !dz))
+        return WORLD_NONE;
+    if (NewCube != -1)
+        return WORLD_CROSS; // ja ha uma troca pendente neste frame
+
+    isl = CurIsland();
+    g = GroupOf(isl);
+    wx = WorldIsle[isl][1] + CurrentCubeX + dx;
+    wz = WorldIsle[isl][2] + CurrentCubeY + dz;
+
+    if (FindCell(g, wx, wz, &tisl, &tcx, &tcy)) {
+        if (CrossLocked(tisl))
+            return WORLD_BLOCKED; // modo historia: ilha ainda nao liberada (parede)
+        scene = -1;
+        // mesma ilha: se uma zona ativa da cena leva para essa area, usa a cena dela
+        if (tisl == Island AND NumCube != NUM_CUBE_PHANTOM) {
+            T_ZONE *pz = ListZone;
+            S32 n, zi, zx, zy;
+            for (n = 0; n < NbZones; n++, pz++) {
+                if (pz->Type != 0 OR !(pz->Info7 & ZONE_ON))
+                    continue;
+                if (SceneCell(pz->Num, &zi, &zx, &zy) AND zi == tisl AND zx == tcx AND zy == tcy) {
+                    scene = pz->Num;
+                    break;
+                }
+            }
+        }
+        if (scene == -1)
+            scene = SceneAt(tisl, tcx, tcy);
+        if (scene == -1)
+            return WORLD_BLOCKED;
+        if (inset < 0 AND WorldSmooth AND Pilot_Active()) {
+            // pilotando: so muda o referencial; a cena da area carrega ao sair do veiculo
+            ShiftSea(dx, dz, tisl, tcx, tcy);
+            InPlace = TRUE;
+            Deferred = TRUE;
+            DefScene = scene;
+            if (WorldDbg)
+                LogPrintf("World: mapa %d area (%d,%d) continuo, cena %d adiada\n", g, wx, wz, scene);
+            return WORLD_CROSS;
+        }
+        NewCube = scene;
+    } else {
+        S32 d, owner = NearestIsle(g, wx, wz, isl, &d);
+        if (owner < 0 OR d > WORLD_MARGIN)
+            return WORLD_BLOCKED;
+        if (inset < 0 AND WorldSmooth AND (NumCube == NUM_CUBE_PHANTOM OR Pilot_Active())) {
+            // mar: nada para carregar; so muda o referencial, sem trocar de cena
+            if (NumCube != NUM_CUBE_PHANTOM OR Deferred) {
+                Deferred = TRUE; // saindo da nave aqui, carrega o mar (cena 94)
+                DefScene = NUM_CUBE_PHANTOM;
+                DefIsland = owner;
+                DefX = wx - WorldIsle[owner][1];
+                DefY = wz - WorldIsle[owner][2];
+            }
+            ShiftSea(dx, dz, owner, wx - WorldIsle[owner][1], wz - WorldIsle[owner][2]);
+            InPlace = TRUE;
+            if (WorldDbg)
+                LogPrintf("World: mapa %d area (%d,%d) mar continuo (ilha %d, area %d,%d)\n", g, wx, wz, owner,
+                          CurrentCubeX, CurrentCubeY);
+            return WORLD_CROSS;
+        }
+        PhantomIsland = PendIsland = owner;
+        PendX = wx - WorldIsle[owner][1];
+        PendY = wz - WorldIsle[owner][2];
+        PendSea = TRUE;
+        NewCube = NUM_CUBE_PHANTOM;
+    }
+
+    if (inset < 0) { // posicao exata ja na area nova (x,z)
+        NewPosX = x;
+        NewPosZ = z;
+    } else {
+        NewPosX = dx > 0 ? inset : (dx < 0 ? 32768 - inset : x);
+        NewPosZ = dz > 0 ? inset : (dz < 0 ? 32768 - inset : z);
+    }
+    NewPosY = y;
+    FlagChgCube = 1;
+    FlagReajustPosTwinsen = FALSE;
+    WorldCausedLoad = TRUE;
+
+    if (WorldDbg)
+        LogPrintf("World: mapa %d area (%d,%d) -> cena %d (ilha %d, area %d,%d)\n", g, wx, wz, NewCube,
+                  NewCube == NUM_CUBE_PHANTOM ? PhantomIsland : tisl,
+                  NewCube == NUM_CUBE_PHANTOM ? PendX : tcx,
+                  NewCube == NUM_CUBE_PHANTOM ? PendY : tcy);
+    return WORLD_CROSS;
+}
+
+/* Saiu do veiculo com a cena adiada: carrega a cena da area onde ele esta. */
+void World_FlushDeferred(S32 x, S32 y, S32 z) {
+    if (!Deferred)
+        return;
+    Deferred = FALSE;
+    if (NewCube != -1)
+        return;
+    if (DefScene == NUM_CUBE_PHANTOM) {
+        PhantomIsland = PendIsland = DefIsland;
+        PendX = DefX;
+        PendY = DefY;
+        PendSea = TRUE;
+    }
+    NewCube = DefScene;
+    NewPosX = x;
+    NewPosY = y;
+    NewPosZ = z;
+    WorldCausedLoad = TRUE;
+    FlagChgCube = 1;
+    FlagReajustPosTwinsen = FALSE;
+    if (WorldDbg)
+        LogPrintf("World: carregando a cena adiada %d\n", DefScene);
+}
+
+void World_SceneLoaded(void) {
+    Deferred = FALSE;
+    // chegou nesta ilha pelo caminho do jogo: fica liberada (vai no save)
+    if (WorldEnabled AND !WorldCausedLoad AND !FlagLoadGame AND Island >= 0 AND Island < 12)
+        ListVarGame[STORY_VAR] |= (S16)(1 << Island);
+    WorldCausedLoad = FALSE;
+    if (!RememberInit) {
+        memset(Remember, 0, sizeof(Remember));
+        RememberInit = TRUE;
+    }
+    if (CubeMode != CUBE_EXTERIEUR)
+        return;
+    if (NumCube == NUM_CUBE_PHANTOM) {
+        if (PendSea) {
+            Island = PhantomIsland = PendIsland;
+            CurrentCubeX = PendX;
+            CurrentCubeY = PendY;
+        }
+        PendSea = FALSE;
+        Planet = TabArrow[Island].Planet; // no mar de Zeelich, zlitos e nao kashes
+        if (WorldEnabled AND LastJingle >= 0)
+            CubeJingle = LastJingle; // mantem a musica da ultima ilha
+        return;
+    }
+    PendSea = FALSE;
+    LastJingle = CubeJingle;
+    if (Island >= 0 AND Island < 12 AND CurrentCubeX >= 0 AND CurrentCubeX <= 15 AND CurrentCubeY >= 0 AND CurrentCubeY <= 15) {
+        S32 i, cx, cy;
+        if (SceneCell(NumCube, &i, &cx, &cy) AND i == Island)
+            Remember[Island][CurrentCubeY][CurrentCubeX] = (S16)NumCube;
+    }
+}
