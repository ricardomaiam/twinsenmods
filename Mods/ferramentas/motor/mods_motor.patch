+/* Cena "adiada": pilotando, a troca de area nao recarrega a cena (os atores da
+   cena antiga ficam onde estao no mundo). Ao sair do veiculo a cena certa da
+   area e carregada (World_FlushDeferred). */
+static S32 Deferred = FALSE;
+static S32 DefScene = -1, DefIsland = 0, DefX = 0, DefY = 0; // destino (cena ou mar 94)
+
+// modo historia: atravessar para uma area dessa ilha esta bloqueado? (andar
+// dentro da ilha em que se esta, mesmo nao liberada, sempre pode)
+static S32 CrossLocked(S32 tisl) {
+    S32 inSea = Deferred ? DefScene == NUM_CUBE_PHANTOM : NumCube == NUM_CUBE_PHANTOM;
+    if (!inSea AND tisl == Island)
+        return FALSE;
+    return !World_IslandUnlocked(tisl);
+}
+
+S32 World_Deferred(void) {
+    return Deferred;
+}
