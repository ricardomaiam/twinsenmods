diff --git a/SOURCES/MODSND.CPP b/SOURCES/MODSND.CPP
new file mode 100644
index 0000000..38c825c
--- /dev/null
+++ b/SOURCES/MODSND.CPP
@@ -0,0 +1,174 @@
+/* MODSND.CPP - Sons extras dos mods. Ver MODSND.H.
+ *
+ * O jogo nao tem um laco de voo da nave Esmer nos samples; o unico som dela
+ * voando esta no video da nave no espaco (VIDEO.HQR, entrada 31): o jato
+ * constante enquanto a camera acompanha a nave, antes dela passar. Esse
+ * trecho e lido do proprio video do jogador (libsmacker), vira mono e um
+ * laco sem emenda (as pontas se misturam), sem o assobio agudo do video
+ * (passa-baixa), e e entregue ao mixer como WAV.
+ */
+#include "C_EXTERN.H"
+#include "MODSND.H"
+#include "DIRECTORIES.H"
+#include "HQR_NAMES.H"
+
+#include <SYSTEM/LOGPRINT.H>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef USE_MVIDEO_SMACKER
+#include "VIDEO_SOURCE.H"
+#endif
+
+#define FLY_VIDEO 31      // a nave no espaco, de perto
+#define FLY_FROM_MS 150   // trecho do jato constante
+#define FLY_TO_MS 1950
+#define FLY_XFADE_MS 350  // mistura das pontas do laco
+#define FLY_LOWPASS_HZ 2600 // corta o assobio agudo (~5,5-6 kHz) do video, fica o ronco
+#define FLY_LOWPASS_POLES 4 // passa-baixa repetido 4x (bem forte acima do corte)
+
+// passa-baixa Butterworth de 2a ordem, aplicado varias vezes sobre o trecho
+static void LowPass(S16 *pcm, S32 n, double rate, double fc, S32 times) {
+    double w = tan(3.14159265358979 * fc / rate), q = 0.70710678, k = 1.0 / (1.0 + w / q + w * w);
+    double b0 = w * w * k, b1 = 2.0 * b0, b2 = b0, a1 = 2.0 * (w * w - 1.0) * k, a2 = (1.0 - w / q + w * w) * k;
+    S32 t, i;
+    for (t = 0; t < times; t++) {
+        double x1 = pcm[0], x2 = pcm[0], y1 = pcm[0], y2 = pcm[0];
+        for (i = 0; i < n; i++) {
+            double x = pcm[i], y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
+            x2 = x1;
+            x1 = x;
+            y2 = y1;
+            y1 = y;
+            pcm[i] = (S16)(y > 32767 ? 32767 : (y < -32768 ? -32768 : y));
+        }
+    }
+}
+
+static U8 *FlyWav = NULL;
+static S32 FlyWavSize = 0;
+static S32 FlyTried = FALSE;
+
+static void Put32(U8 *p, U32 v) {
+    p[0] = (U8)v;
+    p[1] = (U8)(v >> 8);
+    p[2] = (U8)(v >> 16);
+    p[3] = (U8)(v >> 24);
+}
+
+static void Put16(U8 *p, U16 v) {
+    p[0] = (U8)v;
+    p[1] = (U8)(v >> 8);
+}
+
+#ifdef USE_MVIDEO_SMACKER
+static void BuildFly(void) {
+    char path[ADELINE_MAX_PATH];
+    smk s;
+    U8 tracks = 0, ch[7] = {0}, bits[7] = {0};
+    unsigned long rate[7] = {0}, frames = 0;
+    double usf = 0;
+    S16 *pcm = NULL;
+    S32 n = 0, cap, need, a, b, x, i, len;
+    U8 *w;
+
+    GetMoviePath(path, ADELINE_MAX_PATH, VIDEO_HQR_NAME);
+    s = Video_OpenSource(path, FLY_VIDEO);
+    if (!s)
+        return;
+    smk_info_all(s, NULL, &frames, &usf);
+    smk_info_audio(s, &tracks, ch, bits, rate);
+    if (!(tracks & 1) OR !rate[0] OR (bits[0] != 16 AND bits[0] != 8)) {
+        smk_close(s);
+        return;
+    }
+    need = (S32)(rate[0] * (FLY_TO_MS + FLY_XFADE_MS + 100) / 1000);
+    cap = need + 4096;
+    pcm = (S16 *)malloc(cap * sizeof(S16));
+    if (!pcm) {
+        smk_close(s);
+        return;
+    }
+    smk_enable_all(s, SMK_AUDIO_TRACK_0);
+    if (smk_first(s) != SMK_ERROR) {
+        do {
+            unsigned long sz = smk_get_audio_size(s, 0);
+            const unsigned char *d = smk_get_audio(s, 0);
+            S32 step = (ch[0] >= 2 ? 2 : 1) * (bits[0] == 16 ? 2 : 1), k;
+            for (k = 0; d AND k + step <= (S32)sz AND n < cap; k += step) {
+                S32 v;
+                if (bits[0] == 16) {
+                    v = (S16)(d[k] | (d[k + 1] << 8));
+                    if (ch[0] >= 2)
+                        v = (v + (S16)(d[k + 2] | (d[k + 3] << 8))) / 2;
+                } else {
+                    v = ((S32)d[k] - 128) << 8;
+                    if (ch[0] >= 2)
+                        v = (v + (((S32)d[k + 1] - 128) << 8)) / 2;
+                }
+                pcm[n++] = (S16)v;
+            }
+        } while (n < need AND smk_next(s) == SMK_MORE);
+    }
+    smk_close(s);
+
+    a = (S32)(rate[0] * FLY_FROM_MS / 1000);
+    b = (S32)(rate[0] * FLY_TO_MS / 1000);
+    x = (S32)(rate[0] * FLY_XFADE_MS / 1000);
+    if (n < b + x) {
+        free(pcm);
+        return;
+    }
+    LowPass(pcm, n, (double)rate[0], FLY_LOWPASS_HZ, FLY_LOWPASS_POLES);
+    len = b - a;
+    w = (U8 *)malloc(44 + len * 2);
+    if (!w) {
+        free(pcm);
+        return;
+    }
+    memcpy(w, "RIFF", 4);
+    Put32(w + 4, 36 + len * 2);
+    memcpy(w + 8, "WAVEfmt ", 8);
+    Put32(w + 16, 16);
+    Put16(w + 20, 1);
+    Put16(w + 22, 1);
+    Put32(w + 24, (U32)rate[0]);
+    Put32(w + 28, (U32)rate[0] * 2);
+    Put16(w + 32, 2);
+    Put16(w + 34, 16);
+    memcpy(w + 36, "data", 4);
+    Put32(w + 40, len * 2);
+    // laco: o comeco recebe o que vem depois do fim, misturado aos poucos
+    for (i = 0; i < len; i++) {
+        S32 v = pcm[a + i];
+        if (i < x) {
+            double f = (double)i / x;
+            v = (S32)(v * f + pcm[b + i] * (1.0 - f));
+        }
+        Put16(w + 44 + i * 2, (U16)(S16)v);
+    }
+    free(pcm);
+    FlyWav = w;
+    FlyWavSize = 44 + len * 2;
+    LogPrintf("Mods: som de voo da nave lido do video %d (%d Hz, %d ms)\n", FLY_VIDEO, (int)rate[0],
+              (int)(len * 1000 / rate[0]));
+}
+#endif
+
+void *ModSnd_Get(S32 num, S32 *size) {
+    if (num == MODSND_ESMER_FLY) {
+#ifdef USE_MVIDEO_SMACKER
+        if (!FlyTried) {
+            FlyTried = TRUE;
+            BuildFly();
+        }
+#endif
+        if (size)
+            *size = FlyWavSize;
+        return FlyWav;
+    }
+    if (size)
+        *size = 0;
+    return NULL;
+}
