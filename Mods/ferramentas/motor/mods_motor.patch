+
+/* Cupula do modo historia: cada ilha ainda bloqueada fica debaixo de uma
+   cupula transparente (meio elipsoide que cobre todas as areas dela, alta o
+   bastante para nao se passar por cima: so pelo espaco). Ela aparece quando
+   o heroi/nave chega perto, junto com o aviso, e nao deixa entrar
+   (World_DomeBlock empurra para fora da superficie). Desenhada por pixel:
+   o raio da camera de cada pixel contra o elipsoide, com teste de z-buffer e
+   mais opaca na borda (como uma bolha). */
+#define DOME_NEAR 14000 // a cupula comeca a aparecer a essa distancia
+#define DOME_MSG 9000   // e o aviso, a essa
+#define DOME_H 26000.0  // altura (a nave vai ao espaco em 26000)
+#define DOME_LON 64.0   // gomos em volta
+#define DOME_LAT 6.0    // faixas de baixo ate o topo
+#define DOME_LINE 90.0  // meia espessura das linhas (unidades do mundo)
+
+static S32 DomeOk[12];
+static double DomeCX[12], DomeCZ[12], DomeRX[12], DomeRZ[12]; // no mapa do grupo
+
+static S32 DomeOf(S32 isl) {
+    S32 n, x0 = 999, x1 = -999, z0 = 999, z1 = -999;
+    if (isl < 0 OR isl >= 12)
+        return FALSE;
+    if (DomeOk[isl])
+        return DomeOk[isl] > 0;
+    for (n = 0; n < NB_WSCENES; n++)
+        if (WorldScenes[n][1] == isl AND WorldScenes[n][4]) {
+            S32 cx = WorldScenes[n][2] + WorldIsle[isl][1], cz = WorldScenes[n][3] + WorldIsle[isl][2];
+            if (cx < x0) x0 = cx;
+            if (cx > x1) x1 = cx;
+            if (cz < z0) z0 = cz;
+            if (cz > z1) z1 = cz;
+        }
+    if (x1 < x0) {
+        DomeOk[isl] = -1;
+        return FALSE;
+    }
+    DomeCX[isl] = (x0 + x1 + 1) * 16384.0;
+    DomeCZ[isl] = (z0 + z1 + 1) * 16384.0;
+    // elipse que passa pelos cantos do retangulo das areas
+    DomeRX[isl] = (x1 - x0 + 1) * 16384.0 * 1.4142 + 1500.0;
+    DomeRZ[isl] = (z1 - z0 + 1) * 16384.0 * 1.4142 + 1500.0;
+    DomeOk[isl] = 1;
+    return TRUE;
+}
+
+// origem da cena atual no mapa do grupo
+static void SceneOrigin(double *ox, double *oz) {
+    S32 isl = CurIsland();
+    *ox = (WorldIsle[isl][1] + CurrentCubeX) * 32768.0;
+    *oz = (WorldIsle[isl][2] + CurrentCubeY) * 32768.0;
+}
+
+// distancia (no plano) de um ponto local ate a borda da cupula; <0 dentro
+static double DomeDist(S32 isl, double lx, double ly, double lz) {
+    double ox, oz, dx, dz, fh, f, k;
+    SceneOrigin(&ox, &oz);
+    dx = (lx + ox - DomeCX[isl]) / DomeRX[isl];
+    dz = (lz + oz - DomeCZ[isl]) / DomeRZ[isl];
+    fh = dx * dx + dz * dz;
+    k = ly > 0 ? ly / DOME_H : 0;
+    f = 1.0 - k * k; // raio relativo da cupula nessa altura
+    if (f <= 0)
+        return 1e9;
+    return (sqrt(fh) - sqrt(f)) * (DomeRX[isl] < DomeRZ[isl] ? DomeRX[isl] : DomeRZ[isl]);
+}
+
+void World_DomeBlock(S32 *x, S32 y, S32 *z) {
+    S32 isl, g;
+    if (!WorldStory OR !World_Active())
+        return;
+    g = GroupOf(CurIsland());
+    for (isl = 0; isl < 12; isl++) {
+        double ox, oz, dx, dz, fh, f, k, sc;
+        if (GroupOf(isl) != g OR !CrossLocked(isl) OR !DomeOf(isl))
+            continue;
+        SceneOrigin(&ox, &oz);
+        dx = (*x + ox - DomeCX[isl]) / DomeRX[isl];
+        dz = (*z + oz - DomeCZ[isl]) / DomeRZ[isl];
+        fh = dx * dx + dz * dz;
+        k = y > 0 ? y / DOME_H : 0;
+        f = 1.0 - k * k;
+        if (f <= 0 OR fh >= f)
+            continue;
+        if (fh < 1e-9) {
+            dx = 1;
+            dz = 0;
+            fh = 1;
+        }
+        sc = sqrt(f / fh) * 1.0005; // para fora, na mesma direcao (desliza na cupula)
+        *x = (S32)(DomeCX[isl] + dx * sc * DomeRX[isl] - ox);
+        *z = (S32)(DomeCZ[isl] + dz * sc * DomeRZ[isl] - oz);
+    }
+}
+
+static void DrawDome(S32 isl, double a0) {
+    double ox, oz, cx, cy, cz;
+    S32 px, py, x0 = 0, y0 = 0, x1 = (S32)ModeDesiredX - 1, y1 = (S32)ModeDesiredY - 1;
+    U16 *zb = (Fill_Flag_ZBuffer AND PtrZBuffer) ? (U16 *)PtrZBuffer : NULL;
+    double ax, ay, az, bx, by, bz, cxv, cyv, czv; // colunas da rotacao inversa
+    SceneOrigin(&ox, &oz);
+    // camera no espaco "unitario" da cupula
+    cx = (CameraX + ox - DomeCX[isl]) / DomeRX[isl];
+    cy = CameraY / DOME_H;
+    cz = (CameraZ + oz - DomeCZ[isl]) / DomeRZ[isl];
+    // direcao no mundo de cada eixo da camera (rotacao inversa)
+    LongWorldInverseRotatePoint(1 << 14, 0, 0);
+    ax = X0 / 16384.0; ay = Y0 / 16384.0; az = Z0 / 16384.0;
+    LongWorldInverseRotatePoint(0, 1 << 14, 0);
+    bx = X0 / 16384.0; by = Y0 / 16384.0; bz = Z0 / 16384.0;
+    LongWorldInverseRotatePoint(0, 0, 1 << 14);
+    cxv = X0 / 16384.0; cyv = Y0 / 16384.0; czv = Z0 / 16384.0;
+    if (y0 < ClipYMin) y0 = ClipYMin;
+    if (y1 > ClipYMax) y1 = ClipYMax;
+    if (x0 < ClipXMin) x0 = ClipXMin;
+    if (x1 > ClipXMax) x1 = ClipXMax;
+    for (py = y0; py <= y1; py++) {
+        U8 *line = (U8 *)Log + TabOffLine[py];
+        S32 any = FALSE;
+        for (px = x0; px <= x1; px++) {
+            // raio do pixel no espaco girado da camera (o mesmo de LongProjectPoint)
+            // (Xp - XCentre = rel.x * LFactorX / -rel.z, com rel.z = -1 a frente)
+            double rx = (double)(px - XCentre) / LFactorX, ry = -(double)(py - YCentre) / LFactorY;
+            double wx = rx * ax + ry * bx - cxv, wy = rx * ay + ry * by - cyv, wz = rx * az + ry * bz - czv;
+            double dx = wx / DomeRX[isl], dy = wy / DOME_H, dz = wz / DomeRZ[isl];
+            double A = dx * dx + dy * dy + dz * dz, B = cx * dx + cy * dy + cz * dz, C = cx * cx + cy * cy + cz * cz - 1.0;
+            double disc = B * B - A * C, t, hy, nx, ny, nz, nl, vl, fres;
+            S32 a16;
+            if (disc <= 0)
+                continue;
+            t = (-B - sqrt(disc)) / A;
+            if (t <= 0)
+                continue; // a frente ja ficou para tras (dentro): nao desenha
+            hy = cy + dy * t;
+            if (hy < -0.02)
+                continue; // so a metade de cima (abaixo d'agua nao)
+            if (zb) {
+                double depth = t; // rz = 1 por unidade de t
+                U32 zv = depth >= 65535.0 * 65536.0 / (Fill_ZBuffer_Factor ? Fill_ZBuffer_Factor : 1)
+                             ? 65535
+                             : (U32)((depth * Fill_ZBuffer_Factor) / 65536.0);
+                if (zb[TabOffLine[py] + px] < zv)
+                    continue; // atras do relevo ou de uma construcao
+            }
+            // mais opaca de lado (borda da bolha), quase limpa de frente
+            nx = (cx + dx * t);
+            ny = hy;
+            nz = (cz + dz * t);
+            nl = sqrt(nx * nx + ny * ny + nz * nz);
+            vl = sqrt(A);
+            fres = fabs((nx * dx + ny * dy + nz * dz) / (nl * vl));
+            a16 = (S32)(a0 * (4.5 + 8.0 * (1.0 - fres) * (1.0 - fres)));
+            {
+                // gomos da cupula: meridianos e paralelos mais claros
+                double lon = atan2(nz, nx) * (DOME_LON / (2.0 * 3.14159265358979)), lat = asin(ny / nl) * (DOME_LAT / 1.5707963);
+                double fl = lon - floor(lon), ft = lat - floor(lat);
+                double wl = DOME_LINE / (DomeRX[isl] * sqrt(nx * nx + nz * nz) / nl + 1.0) * DOME_LON / 6.2831853;
+                double wt = DOME_LINE / DOME_H * DOME_LAT / 1.5707963;
+                if (fl < wl OR fl > 1.0 - wl OR ft < wt OR ft > 1.0 - wt)
+                    a16 += (S32)(a0 * 5.0);
+            }
+            if (a16 < 1)
+                continue;
+            if (a16 > 12)
+                a16 = 12;
+            line[px] = MmBlend(line[px], (31 << 10) | (31 << 5) | 31, a16);
+            any = TRUE;
+        }
+        if (any)
+            BoxMovingAdd(x0, py, x1, py);
+    }
+}
+
+void World_DrawBarriers(void) {
+    T_OBJET *hero = &ListObjet[NUM_PERSO];
+    S32 isl, g, msg = FALSE;
+    if (!WorldStory OR !World_Active() OR CinemaMode)
+        return;
+    g = GroupOf(CurIsland());
+    EnsureBlend();
+    for (isl = 0; isl < 12; isl++) {
+        double d;
+        if (GroupOf(isl) != g OR !CrossLocked(isl) OR !DomeOf(isl))
+            continue;
+        d = DomeDist(isl, hero->Obj.X, hero->Obj.Y, hero->Obj.Z);
+        if (d > DOME_NEAR)
+            continue;
+        DrawDome(isl, d <= 0 ? 1.0 : 1.0 - d / DOME_NEAR);
+        if (d < DOME_MSG)
+            msg = TRUE;
+    }
+    if (msg)
+        World_DrawMsgBox((S32)ModeDesiredX / 2, 46, Mods_Text(MODS_TXT_LOCKED));
+}
+
+void World_DrawMinimap(void) {
+    S32 g, P, x0, y0, px, py, isl;
+    double s, wx, wz, hx, hy;
+    T_OBJET *hero = &ListObjet[NUM_PERSO];
+
+    if (!MinimapOn OR !World_Active() OR CinemaMode OR FlagAnimWhoSpeak)
+        return;
+    isl = CurIsland();
+    g = GroupOf(isl);
+    if (g < 0 OR g > 2)
+        return;
+    if (!MmH[g])
+        BuildHeights(g);
+    if (!MmH[g])
+        return;
+
+    P = (S32)ModeDesiredY * MinimapSize / 100;
+    if (P < 48)
+        P = 48;
+    if (P > (S32)ModeDesiredY - 20)
+        P = (S32)ModeDesiredY - 20;
+    if (MmImgG != g OR MmImgP != P OR MmImgPal != PalSum())
+        BuildImage(g, P);
+    if (MmImgG != g)
+        return;
+
+    x0 = 10;
+    y0 = (S32)ModeDesiredY - 10 - P;
+    // fundo como o do inventario: a cena escurecida (SHADE_INVENT_LVL 8) e o
+    // mapa por cima, meio transparente
+    {
+        U8 *shade = PtrCLUTGouraud + (15 - MM_SHADE) * 256;
+        for (py = 0; py < P; py++) {
+            U8 *line = (U8 *)Log + TabOffLine[y0 + py] + x0;
+            const U8 *src = MmImg + py * P, *msk = MmMask + py * P;
+            for (px = 0; px < P; px++)
+                if (msk[px]) {
+                    U32 a = MmRgb[src[px]], c = MmRgb[shade[line[px]]];
+                    U32 r = (((a >> 10) & 31) * MM_ALPHA + ((c >> 10) & 31) * (16 - MM_ALPHA)) >> 4;
+                    U32 g = (((a >> 5) & 31) * MM_ALPHA + ((c >> 5) & 31) * (16 - MM_ALPHA)) >> 4;
+                    U32 b = ((a & 31) * MM_ALPHA + (c & 31) * (16 - MM_ALPHA)) >> 4;
+                    line[px] = MmLut[(r << 10) | (g << 5) | b];
+                }
+        }
+    }
+    // a moldura do inventario
+    DrawCadre(x0, y0, x0 + P - 1, y0 + P - 1, ALL_ANGLES);
+    // o nome do lugar (a cena logica: pilotando, a troca de cena fica adiada)
+    if (Deferred)
+        DrawPlaceBox(x0, y0 - 4, P, DefIsland, DefScene == NUM_CUBE_PHANTOM);
+    else
+        DrawPlaceBox(x0, y0 - 4, P, isl, NumCube == NUM_CUBE_PHANTOM);
+
+    // Twinsen
+    s = (double)P / MmVW;
+    wx = WorldIsle[isl][1] + CurrentCubeX + hero->Obj.X / 32768.0;
+    wz = WorldIsle[isl][2] + CurrentCubeY + hero->Obj.Z / 32768.0;
+    hx = x0 + ((wx - MmX0[g]) * MM_RES - MmVX0) * s;
+    hy = y0 + P - ((wz - MmZ0[g]) * MM_RES - MmVZ0) * s;
+    if (hx < x0 + 6) hx = x0 + 6;
+    if (hy < y0 + 6) hy = y0 + 6;
+    if (hx > x0 + P - 7) hx = x0 + P - 7;
+    if (hy > y0 + P - 7) hy = y0 + P - 7;
+    {
+        double a = hero->Obj.Beta * (2.0 * 3.14159265358979 / 4096.0);
+        double L = P / 26.0 + 2.5, dx = sin(a), dy = -cos(a);
+        double tx = hx + dx * L, ty = hy + dy * L;
+        double lx = hx - dx * L * 0.7 - dy * L * 0.65, ly = hy - dy * L * 0.7 + dx * L * 0.65;
+        double rx = hx - dx * L * 0.7 + dy * L * 0.65, ry = hy - dy * L * 0.7 - dx * L * 0.65;
+        double nx = hx - dx * L * 0.35, ny = hy - dy * L * 0.35; // entalhe de tras
+        S32 ix, iy;
+        for (iy = (S32)(hy - L - 2); iy <= (S32)(hy + L + 2); iy++)
+            for (ix = (S32)(hx - L - 2); ix <= (S32)(hx + L + 2); ix++) {
+                double cx = ix + 0.5, cy = iy + 0.5, e1, e2, e3, f1, f2, f3;
+                // seta = dois triangulos (ponta-esquerda-entalhe e ponta-entalhe-direita)
+                e1 = (lx - tx) * (cy - ty) - (ly - ty) * (cx - tx);
+                e2 = (nx - lx) * (cy - ly) - (ny - ly) * (cx - lx);
+                e3 = (tx - nx) * (cy - ny) - (ty - ny) * (cx - nx);
+                f1 = (nx - tx) * (cy - ty) - (ny - ty) * (cx - tx);
+                f2 = (rx - nx) * (cy - ny) - (ry - ny) * (cx - nx);
+                f3 = (tx - rx) * (cy - ry) - (ty - ry) * (cx - rx);
+                if (((e1 >= 0 AND e2 >= 0 AND e3 >= 0) OR (e1 <= 0 AND e2 <= 0 AND e3 <= 0))
+                        OR ((f1 >= 0 AND f2 >= 0 AND f3 >= 0) OR (f1 <= 0 AND f2 <= 0 AND f3 <= 0)))
+                    PutPix(ix, iy, ColArrow);
+            }
+        Line((S32)tx, (S32)ty, (S32)lx, (S32)ly, ColArrowEdge);
+        Line((S32)lx, (S32)ly, (S32)nx, (S32)ny, ColArrowEdge);
+        Line((S32)nx, (S32)ny, (S32)rx, (S32)ry, ColArrowEdge);
+        Line((S32)rx, (S32)ry, (S32)tx, (S32)ty, ColArrowEdge);
+    }
+    BoxMovingAdd(x0, y0, x0 + P - 1, y0 + P - 1);
+}
