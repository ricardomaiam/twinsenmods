+S32 MinimapOn = TRUE; // cvar "minimap"
+S32 MinimapSize = 22; // % da altura da tela
+
+#define MM_RES 16 // amostras por area
+#define MM_VIEW 3 // areas de mar mostradas alem das ilhas
+#define MM_DEEP (-2000)
+
+static S16 *MmH[3] = {NULL, NULL, NULL}; // alturas
+static U8 *MmDist[3] = {NULL, NULL, NULL}; // distancia (amostras) ate a terra
+static S32 MmX0[3], MmZ0[3], MmW[3], MmHt[3]; // limites em areas
+
+static U8 *MmImg = NULL, *MmMask = NULL; // imagem pronta do mapa
+#define MM_SHADE 8  // escurecimento do fundo (o mesmo do inventario)
+#define MM_ALPHA 10 // opacidade do mapa, em 16 avos
+static S32 MmImgP = 0, MmImgG = -1;
+static U32 MmImgPal = 0;
+static S32 MmVX0, MmVZ0, MmVW; // parte mostrada (em amostras)
+static U8 ColArrow, ColArrowEdge;
+
+static void GroupBounds(S32 g, S32 *x0, S32 *z0, S32 *x1, S32 *z1) {
+    S32 n, first = TRUE;
+    for (n = 0; n < NB_WSCENES; n++) {
+        S32 i = WorldScenes[n][1], wx, wz;
+        if (GroupOf(i) != g)
+            continue;
+        wx = WorldScenes[n][2] + WorldIsle[i][1];
+        wz = WorldScenes[n][3] + WorldIsle[i][2];
+        if (first OR wx < *x0) *x0 = wx;
+        if (first OR wz < *z0) *z0 = wz;
+        if (first OR wx > *x1) *x1 = wx;
+        if (first OR wz > *z1) *z1 = wz;
+        first = FALSE;
+    }
+    *x0 -= WORLD_MARGIN;
+    *z0 -= WORLD_MARGIN;
+    *x1 += WORLD_MARGIN;
+    *z1 += WORLD_MARGIN;
+}
+
+static void BuildHeights(S32 g) {
+    static U8 map[256 + 2048];
+    static S16 hgt[65 * 65 + 2048];
+    char name[64], path[ADELINE_MAX_PATH];
+    S32 x0 = 0, z0 = 0, x1 = 0, z1 = 0, w, h, isl, i, pass, x, z;
+    S16 *H;
+    U8 *D;
+
+    GroupBounds(g, &x0, &z0, &x1, &z1);
+    w = (x1 - x0 + 1) * MM_RES;
+    h = (z1 - z0 + 1) * MM_RES;
+    H = (S16 *)malloc(w * h * sizeof(S16));
+    D = (U8 *)malloc(w * h);
+    if (!H OR !D) {
+        free(H);
+        free(D);
+        return;
+    }
+    for (i = 0; i < w * h; i++)
+        H[i] = MM_DEEP;
+    MmX0[g] = x0;
+    MmZ0[g] = z0;
+    MmW[g] = x1 - x0 + 1;
+    MmHt[g] = z1 - z0 + 1;
+
+    for (isl = 0; isl < 12; isl++) {
+        S32 cx, cy;
+        if (GroupOf(isl) != g)
+            continue;
+        snprintf(name, sizeof(name), "%s.ile", IleLst[isl]);
+        GetResPath(path, ADELINE_MAX_PATH, name);
+        if (!Load_HQR(path, map, 0))
+            continue;
+        for (cy = 0; cy < 16; cy++)
+            for (cx = 0; cx < 16; cx++) {
+                S32 idx = map[cy * 16 + cx] & 127, sx, sz;
+                if (!idx)
+                    continue;
+                if (!Load_HQR(path, hgt, 3 + 6 * (idx - 1) + 4))
+                    continue;
+                for (sz = 0; sz < MM_RES; sz++)
+                    for (sx = 0; sx < MM_RES; sx++) {
+                        S32 y = hgt[(sz * 64 / MM_RES) * 65 + sx * 64 / MM_RES];
+                        S32 bx = (cx + WorldIsle[isl][1] - x0) * MM_RES + sx;
+                        S32 bz = (cy + WorldIsle[isl][2] - z0) * MM_RES + sz;
+                        // so a terra conta; o fundo do mar vem da distancia ao litoral
+                        H[bz * w + bx] = (S16)(y > 0 ? y : MM_DEEP);
+                    }
+            }
+    }
+
+    // distancia ate a terra (chanfro 3-4, em amostras)
+    for (i = 0; i < w * h; i++)
+        D[i] = H[i] > 0 ? 0 : 255;
+    for (pass = 0; pass < 2; pass++) {
+        S32 step = pass ? -1 : 1;
+        for (z = pass ? h - 1 : 0; pass ? z >= 0 : z < h; z += step)
+            for (x = pass ? w - 1 : 0; pass ? x >= 0 : x < w; x += step) {
+                S32 d = D[z * w + x], nx = x - step, nz = z - step, v;
+                if (nx >= 0 AND nx < w) {
+                    v = D[z * w + nx] + 3;
+                    if (v < d) d = v;
+                }
+                if (nz >= 0 AND nz < h) {
+                    v = D[nz * w + x] + 3;
+                    if (v < d) d = v;
+                    if (nx >= 0 AND nx < w) {
+                        v = D[nz * w + nx] + 4;
+                        if (v < d) d = v;
+                    }
+                    if (x + step >= 0 AND x + step < w) {
+                        v = D[nz * w + x + step] + 4;
+                        if (v < d) d = v;
+                    }
+                }
+                D[z * w + x] = (U8)(d > 255 ? 255 : d);
+            }
+    }
+    MmH[g] = H;
+    MmDist[g] = D;
+}
+
+static S32 PalMax6 = -1;
+
+static U8 PalColor(double r, double g, double b) {
+    S32 i, best = 0, bestd = 0x7FFFFFFF;
+    if (!PtrPalCurrent)
+        return 15;
+    if (PalMax6 < 0) {
+        S32 mx = 0;
+        for (i = 0; i < 768; i++)
+            if (PtrPalCurrent[i] > mx)
+                mx = PtrPalCurrent[i];
+        PalMax6 = mx < 64;
+    }
+    if (PalMax6) {
+        r /= 4;
+        g /= 4;
+        b /= 4;
+    }
+    for (i = 1; i < 256; i++) {
+        double dr = PtrPalCurrent[i * 3] - r, dg = PtrPalCurrent[i * 3 + 1] - g, db = PtrPalCurrent[i * 3 + 2] - b;
+        S32 d = (S32)(dr * dr * 3 + dg * dg * 4 + db * db * 2);
+        if (d < bestd) {
+            bestd = d;
+            best = i;
+        }
+    }
+    return (U8)best;
+}
+
+static double Lerp(double a, double b, double t) {
+    return a + (b - a) * t;
+}
+
+// cor (rgb) de uma amostra
+static void SampleRGB(S32 g, double fx, double fz, double *r, double *gg, double *b) {
+    S32 w = MmW[g] * MM_RES, h = MmHt[g] * MM_RES, ix, iz;
+    double tx, tz, hh, d;
+    const S16 *H = MmH[g];
+    const U8 *D = MmDist[g];
+
+    if (fx < 0) fx = 0;
+    if (fz < 0) fz = 0;
+    if (fx > w - 2) fx = w - 2;
+    if (fz > h - 2) fz = h - 2;
+    ix = (S32)fx;
+    iz = (S32)fz;
+    tx = fx - ix;
+    tz = fz - iz;
+#define HV(a, c) ((double)(H[(c) * w + (a)] > 0 ? H[(c) * w + (a)] : -60.0 * D[(c) * w + (a)] / 3.0))
+    hh = Lerp(Lerp(HV(ix, iz), HV(ix + 1, iz), tx), Lerp(HV(ix, iz + 1), HV(ix + 1, iz + 1), tx), tz);
+
+    if (hh > 0) {
+        // terra: praia, grama, rocha, pico + sombra do relevo (luz do noroeste)
+        double hl = HV(ix > 0 ? ix - 1 : ix, iz), hr = HV(ix + 1 < w ? ix + 1 : ix, iz);
+        double hu = HV(ix, iz > 0 ? iz - 1 : iz), hd = HV(ix, iz + 1 < h ? iz + 1 : iz);
+        double shade = 1.0 + ((hr - hl) * -0.6 + (hd - hu) * 0.6) / 1500.0;
+        double R, G, B;
+        if (shade < 0.7) shade = 0.7;
+        if (shade > 1.25) shade = 1.25;
+        if (hh < 250) {
+            R = 214; G = 196; B = 132;
+        } else if (hh < 1600) {
+            double t = (hh - 250) / 1350.0;
+            R = Lerp(122, 86, t); G = Lerp(158, 122, t); B = Lerp(72, 56, t);
+        } else if (hh < 3500) {
+            double t = (hh - 1600) / 1900.0;
+            R = Lerp(120, 150, t); G = Lerp(110, 140, t); B = Lerp(88, 120, t);
+        } else {
+            R = 205; G = 200; B = 190;
+        }
+        if (g == 1) { // Zeelich: terra mais avermelhada
+            R = R * 1.05 + 8;
+            B = B * 0.95;
+        }
+        *r = R * shade;
+        *gg = G * shade;
+        *b = B * shade;
+    } else {
+        // mar: clareia perto da costa, espuma junto da praia
+        static const double sea[3][4][3] = {
+            {{24, 64, 112}, {34, 96, 148}, {70, 148, 182}, {170, 214, 220}},  // Twinsun: agua
+            {{66, 52, 86}, {92, 78, 112}, {126, 112, 142}, {182, 172, 192}},  // Zeelich: gas
+            {{98, 26, 18}, {138, 44, 26}, {182, 86, 44}, {228, 160, 92}},     // sob o gas
+        };
+        const double(*c)[3] = sea[g < 0 OR g > 2 ? 0 : g];
+        double dist = -hh / 20.0; // ~ amostras ate a costa
+        S32 k;
+        double t, R[3];
+        if (dist < 1.2) {
+            t = dist / 1.2;
+            for (k = 0; k < 3; k++) R[k] = Lerp(c[3][k], c[2][k], t);
+        } else if (dist < 10) {
+            t = (dist - 1.2) / 8.8;
+            for (k = 0; k < 3; k++) R[k] = Lerp(c[2][k], c[1][k], t);
+        } else {
+            t = (dist - 10) / 40.0;
+            if (t > 1) t = 1;
+            for (k = 0; k < 3; k++) R[k] = Lerp(c[1][k], c[0][k], t);
+        }
+        *r = R[0];
+        *gg = R[1];
+        *b = R[2];
+    }
+#undef HV
+}
+
+static U32 PalSum(void) {
+    U32 sum = 0;
+    S32 i;
+    if (PtrPalCurrent)
+        for (i = 0; i < 768; i++)
+            sum = sum * 31 + PtrPalCurrent[i];
+    return sum;
+}
+
+// mistura meio transparente: indice de paleta -> RGB 5:5:5 -> indice
+static U8 MmLut[32 * 32 * 32];
+static U16 MmRgb[256];
+
+static void BuildBlendLut(void) {
+    S32 i, r, g, b, k;
+    if (!PtrPalCurrent)
+        return;
+    PalColor(0, 0, 0); // define PalMax6
+    k = PalMax6 > 0 ? 4 : 1;
+    for (i = 0; i < 256; i++) {
+        S32 cr = PtrPalCurrent[i * 3] * k, cg = PtrPalCurrent[i * 3 + 1] * k, cb = PtrPalCurrent[i * 3 + 2] * k;
+        MmRgb[i] = (U16)(((cr > 255 ? 255 : cr) >> 3) << 10 | ((cg > 255 ? 255 : cg) >> 3) << 5 | ((cb > 255 ? 255 : cb) >> 3));
+    }
+    for (r = 0; r < 32; r++)
+        for (g = 0; g < 32; g++)
+            for (b = 0; b < 32; b++)
+                MmLut[(r << 10) | (g << 5) | b] = PalColor(r * 255 / 31, g * 255 / 31, b * 255 / 31);
+}
+
+static void BuildImage(S32 g, S32 P) {
+    S32 vx0 = 0, vz0 = 0, vx1 = 0, vz1 = 0, px, py;
+    double s;
+
+    free(MmImg);
+    free(MmMask);
+    MmImg = (U8 *)malloc(P * P);
+    MmMask = (U8 *)malloc(P * P);
+    if (!MmImg OR !MmMask) {
+        MmImgG = -1;
+        return;
+    }
+    PalMax6 = -1;
+
+    GroupBounds(g, &vx0, &vz0, &vx1, &vz1);
+    vx0 += WORLD_MARGIN - MM_VIEW;
+    vz0 += WORLD_MARGIN - MM_VIEW;
+    vx1 -= WORLD_MARGIN - MM_VIEW;
+    vz1 -= WORLD_MARGIN - MM_VIEW;
+    if (vx1 - vx0 < vz1 - vz0) {
+        S32 d = (vz1 - vz0) - (vx1 - vx0);
+        vx0 -= d / 2;
+        vx1 += d - d / 2;
+    } else {
+        S32 d = (vx1 - vx0) - (vz1 - vz0);
+        vz0 -= d / 2;
+        vz1 += d - d / 2;
+    }
+    MmVX0 = (vx0 - MmX0[g]) * MM_RES;
+    MmVZ0 = (vz0 - MmZ0[g]) * MM_RES;
+    MmVW = (vx1 - vx0 + 1) * MM_RES;
+    s = (double)MmVW / P; // amostras por pixel
+
+    // recorte de cantos chanfrados, como a moldura do inventario (DrawCadre)
+    for (py = 0; py < P; py++)
+        for (px = 0; px < P; px++) {
+            double r, gg, b;
+            S32 ex = px < P - 1 - px ? px : P - 1 - px, ey = py < P - 1 - py ? py : P - 1 - py, m = 1;
+            if (ex == 0 OR ey == 0 OR ex + ey < 6)
+                m = 0; // a linha da moldura e o lado de fora do chanfro
+            MmMask[py * P + px] = (U8)m;
+            if (m) {
+                SampleRGB(g, MmVX0 + (px + 0.5) * s, MmVZ0 + MmVW - (py + 0.5) * s, &r, &gg, &b);
+                MmImg[py * P + px] = PalColor(r, gg, b);
+            }
+        }
+    BuildBlendLut();
+    ColArrow = PalColor(235, 40, 30);
+    ColArrowEdge = PalColor(255, 245, 150);
+    MmImgP = P;
+    MmImgG = g;
+    MmImgPal = PalSum();
+}
+
+static void PutPix(S32 x, S32 y, U8 c) {
+    if (x < 0 OR y < 0 OR x >= (S32)ModeDesiredX OR y >= (S32)ModeDesiredY)
+        return;
+    ((U8 *)Log)[TabOffLine[y] + x] = c;
+}
