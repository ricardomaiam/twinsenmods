+/* Chegada do espaco: a area da ilha mais perto do meio dela. */
+void World_TeleportIsland(S32 island, S32 x, S32 y, S32 z) {
+    S32 n, cnt = 0, sx = 0, sy = 0, best = -1, bd = 0x7FFFFFFF;
+    for (n = 0; n < NB_WSCENES; n++)
+        if (WorldScenes[n][1] == island AND WorldScenes[n][4]) {
+            sx += WorldScenes[n][2];
+            sy += WorldScenes[n][3];
+            cnt++;
+        }
+    if (!cnt)
+        return;
+    for (n = 0; n < NB_WSCENES; n++)
+        if (WorldScenes[n][1] == island AND WorldScenes[n][4]) {
+            S32 dx = WorldScenes[n][2] * cnt - sx, dy = WorldScenes[n][3] * cnt - sy, d = dx * dx + dy * dy;
+            if (d < bd) {
+                bd = d;
+                best = n;
+            }
+        }
+    // chegando de fora (espaco): a musica e a da ilha, mesmo no mar dela
+    {
+        char path[ADELINE_MAX_PATH];
+        U8 *sc;
+        GetResPath(path, ADELINE_MAX_PATH, SCENE_HQR_NAME);
+        sc = (U8 *)LoadMalloc_HQR(path, WorldScenes[best][0] + 1);
+        if (sc) {
+            S32 j = (S8)sc[55]; // CubeJingle no cabecalho da cena (ver DISKFUNC)
+            if (j >= 0)
+                LastJingle = j;
+            if (WorldDbg)
+                LogPrintf("World: chegada na ilha %d (cena %d), musica %d\n", island, WorldScenes[best][0], j);
+            Free(sc);
+        }
+    }
+    World_Teleport(island, WorldScenes[best][2], WorldScenes[best][3], x, y, z);
+}
+
+void World_Teleport(S32 island, S32 cx, S32 cy, S32 x, S32 y, S32 z) {
+    S32 scene = SceneAt(island, cx, cy);
+    if (scene < 0) {
+        if (GroupOf(island) < 0)
+            return;
+        PhantomIsland = PendIsland = island;
+        PendX = cx;
+        PendY = cy;
+        PendSea = TRUE;
+        scene = NUM_CUBE_PHANTOM;
+    }
+    NewCube = scene;
+    NewPosX = x;
+    NewPosY = y;
+    NewPosZ = z;
+    FlagChgCube = 1;
+    FlagReajustPosTwinsen = FALSE;
+    WorldCausedLoad = TRUE;
+}
