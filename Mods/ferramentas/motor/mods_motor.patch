+U16 Pilot_RemapGenAnim(U16 genanim) {
+    if (!PilotOn)
+        return genanim;
+    switch (genanim) {
+    case GEN_ANIM_MORT:
+        return genanim;
+    default:
+        return GEN_ANIM_RIEN;
+    }
+}
