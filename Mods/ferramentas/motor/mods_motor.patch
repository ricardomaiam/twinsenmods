+/* WORLDMAP.H - Mapa aberto (mod): todas as ilhas de um planeta num mapa so.
+ *
+ * Twinsun (Cidadela + Deserto), Zeelich (Otringal, Celebracao, Knartas,
+ * Ilhota CX, Elevador) e o mundo sob o gas (Plataforma, Mosquibees,
+ * Sob-Celebracao) viram tres mapas continuos: sai-se por qualquer borda de
+ * uma area para a area vizinha, para o mar aberto (cubo fantasma 94) ou para
+ * outra ilha. Ver WORLDMAP.CPP.
+ */
+#ifndef WORLDMAP_H
+#define WORLDMAP_H
+
+#include <SYSTEM/ADELINE_TYPES.H>
+
+#define WORLD_NONE 0    // nao tratado: segue o jogo original
+#define WORLD_CROSS 1   // troca de area preparada (NewCube/NewPos)
+#define WORLD_BLOCKED 2 // fim do mapa: a borda e parede
+
+#define WORLD_EDGE 24 // margem do heroi na borda da area (o motor usa 256)
+
+extern S32 WorldEnabled; // mod ativo (gerenciador) / cvar "world"
+extern S32 WorldDbg;
+
+S32 World_Active(void);
+
+// O heroi (ou a nave) bateu na borda da area na direcao (dx,dz) em -1/0/1.
+// x,y,z = posicao atual; inset = distancia da borda ao chegar do outro lado.
+// inset < 0: x,z ja sao a posicao exata na area nova (sem salto).
+S32 World_Cross(S32 dx, S32 dz, S32 x, S32 y, S32 z, S32 inset);
+
+// TRUE (uma vez) se a ultima travessia foi feita sem trocar de cena (mar->mar):
+// o chamador poe o heroi/nave ja na posicao nova (x,z dados a World_Cross).
+S32 World_TookInPlace(void);
+
+// Pilotando, as areas de ilha tambem passam sem recarregar: a cena certa e
+// carregada so quando ele sai do veiculo. Sem salvar enquanto isso.
+S32 World_Deferred(void);
+void World_FlushDeferred(S32 x, S32 y, S32 z);
+extern S32 WorldSmooth;
+extern S32 WorldViewPct; // distancia de visao (% do original), cvar "world_view"
+
+// Fim do LoadScene: corrige planeta/musica no mar aberto e memoriza a cena.
+void World_SceneLoaded(void);
+
+// Teste (console): leva o heroi para o mar na direcao dada.
+void World_Teleport(S32 island, S32 cx, S32 cy, S32 x, S32 y, S32 z);
+void World_TeleportIsland(S32 island, S32 x, S32 y, S32 z); // area central da ilha
+
+// Modo historia (chave "worldstory"): ilhas so alcancaveis depois de
+// liberadas pela historia; a borda para uma ilha bloqueada e uma parede.
+extern S32 WorldStory;
+S32 World_IslandUnlocked(S32 isl);
+void World_DrawBarriers(void);                       // fim do AffScene, antes do mapa (cupulas)
+void World_DomeBlock(S32 *x, S32 y, S32 *z);         // nao deixa entrar numa cupula (posicao local)
+void World_DrawMsgBox(S32 cx, S32 cy, const char *str); // caixa de aviso (estilo inventario)
+
+// Mini holomap no canto inferior esquerdo (fim do AffScene).
+extern S32 MinimapOn, MinimapSize;
+void World_DrawMinimap(void);
+
+#endif
