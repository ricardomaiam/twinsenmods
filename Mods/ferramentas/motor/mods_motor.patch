+
+/* ------------------------------------------------------------------------
+   Luzes da nave Esmer ligada: as do proprio jogo. A nave que sai da base
+   (Otringal) alterna dois corpos, 72 e 73 (76 e 77 na versao com porta e
+   insignias), em que segmentos da faixa vermelha da borda viram lampadas
+   amarelas acesas (poligonos solidos, cor 0x106D): no 72 os dos lados de tras
+   e da frente-diagonal, no 73 os dos lados da frente e os dois do bico.
+   Para os cascos que nao tem essa versao acesa (71, com porta e sem
+   insignias; 74) o mesmo e feito numa copia do corpo: os mesmos segmentos
+   da borda passam a lampada. Troca so no desenho (Body.Num volta depois).
+   ------------------------------------------------------------------------ */
+#define PILOT_BODY_BASE 0x7EC0
+#define LIT_COLOR 0x106D
+#define LIT_MS 250 // troca das lampadas (as duas metades se alternam)
+
+static U8 *LitBody[2] = {NULL, NULL};
+static S32 LitBase = -1;
+
+static S16 LRd16(const U8 *p) { return (S16)(p[0] | (p[1] << 8)); }
+static S32 LRd32(const U8 *p) { return (S32)(p[0] | (p[1] << 8) | (p[2] << 16) | ((U32)p[3] << 24)); }
+static void LWr16(U8 *p, S32 v) {
+    p[0] = (U8)v;
+    p[1] = (U8)(v >> 8);
+}
+static void LWr32(U8 *p, S32 v) {
+    LWr16(p, v);
+    LWr16(p + 2, v >> 16);
+}
+static S32 LSecCount(const U8 *b, S32 s) { return LRd32(b + 0x20 + s * 8); }
+static S32 LSecOff(const U8 *b, S32 s) { return LRd32(b + 0x24 + s * 8); }
+static S32 LPolySize(U16 t) {
+    if (t & (1 << 14))
+        return 16;
+    if ((t & 0xFF) <= 7)
+        return 12;
+    return (t & (1 << 15)) ? 32 : 24;
+}
+
+// lampadas de cada metade (centro do segmento da borda, x/z; y ~1200)
+static const S16 LitSpots[2][4][2] = {{{-1700, -400}, {-1200, 1200}, {1200, 1200}, {1700, -400}},
+                                      {{-1700, 400}, {-400, 1700}, {400, 1700}, {1700, 400}}};
+
+static U8 *BuildLitBody(S32 base, S32 half) {
+    U8 *src = (U8 *)HQR_Get(HQR_Bodys, base), *B, *out, *p;
+    S32 size, nbG, nbP, g, i, k, off, end, pick[4], pickD[4], idx, sel = 0;
+    S32 *gx, *gy, *gz, *px, *py, *pz;
+    if (!src)
+        return NULL;
+    size = LRd32(src + 0x5C) + LRd32(src + 0x58) * 4;
+    B = (U8 *)malloc(size);
+    if (!B)
+        return NULL;
+    memcpy(B, src, size);
+    nbG = LSecCount(B, 0);
+    nbP = LSecCount(B, 1);
+    gx = (S32 *)calloc(nbG * 3 + nbP * 3, sizeof(S32));
+    if (!gx) {
+        free(B);
+        return NULL;
+    }
+    gy = gx + nbG;
+    gz = gy + nbG;
+    px = gz + nbG;
+    py = px + nbP;
+    pz = py + nbP;
+    // posicao de repouso: origem do grupo = ponto pivo (do grupo pai)
+    for (i = 0; i < nbP; i++) {
+        const U8 *pt = B + LSecOff(B, 1) + i * 8;
+        S32 grp = (U16)LRd16(pt + 6);
+        if (grp >= nbG)
+            grp = 0;
+        px[i] = LRd16(pt) + gx[grp];
+        py[i] = LRd16(pt + 2) + gy[grp];
+        pz[i] = LRd16(pt + 4) + gz[grp];
+        // grupos filhos cujo pivo e este ponto
+        for (g = 0; g < nbG; g++) {
+            const U8 *gr = B + LSecOff(B, 0) + g * 8;
+            if ((U16)LRd16(gr) != 0xFFFF AND (U16)LRd16(gr + 2) == i) {
+                gx[g] = px[i];
+                gy[g] = py[i];
+                gz[g] = pz[i];
+            }
+        }
+    }
+    // os segmentos vermelhos da borda mais perto de cada lampada
+    for (k = 0; k < 4; k++) {
+        pick[k] = -1;
+        pickD[k] = 300 * 300;
+    }
+    off = LSecOff(B, 4);
+    end = LSecOff(B, 5);
+    idx = 0;
+    while (off + 8 <= end) {
+        U16 t = (U16)LRd16(B + off);
+        S32 nb = (U16)LRd16(B + off + 2), rs = LPolySize(t);
+        for (i = 0; i < nb; i++, idx++) {
+            const U8 *r = B + off + 8 + i * rs;
+            S32 cx = 0, cy = 0, cz = 0, j;
+            if (!(t & (1 << 15)) OR (t & (1 << 14)) OR (t & 0xFF) > 7 OR (U16)LRd16(r + 8) != 0x1040)
+                continue;
+            for (j = 0; j < 4; j++) {
+                S32 q = (U16)LRd16(r + j * 2);
+                if (q >= nbP)
+                    break;
+                cx += px[q];
+                cy += py[q];
+                cz += pz[q];
+            }
+            if (j < 4)
+                continue;
+            cx /= 4;
+            cy /= 4;
+            cz /= 4;
+            if (cy < 1000 OR cy > 1400)
+                continue;
+            for (k = 0; k < 4; k++) {
+                S32 dx = cx - LitSpots[half][k][0], dz = cz - LitSpots[half][k][1], d = dx * dx + dz * dz;
+                if (d < pickD[k]) {
+                    pickD[k] = d;
+                    pick[k] = idx;
+                }
+            }
+        }
+        off += 8 + nb * rs;
+    }
+    free(gx);
+    for (k = 0; k < 4; k++)
+        sel += pick[k] >= 0;
+    if (!sel) {
+        free(B);
+        return NULL;
+    }
+
+    // remonta os poligonos: as lampadas saem dos seus blocos e vao para um
+    // bloco novo de quadrilateros solidos (sem sombra: acesos)
+    out = (U8 *)calloc(1, size + 16 + 12 * 4);
+    if (!out) {
+        free(B);
+        return NULL;
+    }
+    memcpy(out, B, LSecOff(B, 4));
+    p = out + LSecOff(B, 4);
+    off = LSecOff(B, 4);
+    idx = 0;
+    {
+        U8 lit[4 * 12];
+        S32 nlit = 0;
+        while (off + 8 <= end) {
+            U16 t = (U16)LRd16(B + off);
+            S32 nb = (U16)LRd16(B + off + 2), rs = LPolySize(t), n = 0;
+            U8 *hdr = p;
+            p += 8;
+            for (i = 0; i < nb; i++, idx++) {
+                const U8 *r = B + off + 8 + i * rs;
+                S32 isLit = 0;
+                for (k = 0; k < 4; k++)
+                    if (pick[k] == idx)
+                        isLit = 1;
+                if (isLit AND nlit < 4) {
+                    memcpy(lit + nlit * 12, r, 12);
+                    LWr16(lit + nlit * 12 + 8, LIT_COLOR);
+                    nlit++;
+                    continue;
+                }
+                memcpy(p, r, rs);
+                p += rs;
+                n++;
+            }
+            if (n) {
+                LWr16(hdr, t);
+                LWr16(hdr + 2, n);
+                LWr32(hdr + 4, (S32)(p - hdr));
+            } else
+                p = hdr;
+            off += 8 + nb * rs;
+        }
+        if (nlit) {
+            LWr16(p, 0x8000); // quadrilatero, POLY_SOLID
+            LWr16(p + 2, nlit);
+            LWr32(p + 4, 8 + nlit * 12);
+            memcpy(p + 8, lit, nlit * 12);
+            p += 8 + nlit * 12;
+        }
+    }
+    for (k = 5; k <= 7; k++) {
+        S32 cnt = LSecCount(B, k), rec = (k == 7) ? 4 : 8;
+        LWr32(out + 0x20 + k * 8, cnt);
+        LWr32(out + 0x24 + k * 8, (S32)(p - out));
+        memcpy(p, B + LSecOff(B, k), cnt * rec);
+        p += cnt * rec;
+    }
+    free(B);
+    LogPrintf("Pilot: corpo %d com as lampadas acesas (metade %d, %d lampadas)\n", base, half, sel);
+    return out;
+}
+
+void *Pilot_GetBody(S32 index) {
+    S32 slot = index - PILOT_BODY_BASE;
+    if (slot < 0 OR slot > 1)
+        return NULL;
+    return LitBody[slot];
+}
+
+// corpo a desenhar com as luzes acesas (-1: o normal)
+S32 Pilot_DrawBody(S32 numobj) {
+    T_OBJET *o;
+    S32 base, half;
+    if (!PilotOn OR numobj != PilotObj)
+        return -1;
+    o = &ListObjet[numobj];
+    if (o->IndexFile3D != ESMER_FILE3D OR IsDino(o))
+        return -1;
+    base = o->Obj.Body.Num;
+    half = (S32)((TimerRefHR / LIT_MS) & 1);
+    if (base == 70 OR base == 72 OR base == 73)
+        return half ? 73 : 72; // os corpos do jogo
+    if (base == 75 OR base == 76 OR base == 77)
+        return half ? 77 : 76;
+    if (base != 71 AND base != 74)
+        return -1;
+    if (LitBase != base) {
+        for (half = 0; half < 2; half++) {
+            free(LitBody[half]);
+            LitBody[half] = BuildLitBody(base, half);
+        }
+        LitBase = base;
+        half = (S32)((TimerRefHR / LIT_MS) & 1);
+    }
+    if (!LitBody[half])
+        return -1;
+    return PILOT_BODY_BASE + half;
+}
