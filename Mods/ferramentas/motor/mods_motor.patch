+/* PILOT.H - Pilotar naves e veiculos (mod)
+ *
+ * Perto de uma nave (qualquer ator grande da cena), V entra e V sai.
+ * Pilotando: setas = frente/tras e girar, A/D = ir para os lados,
+ * E/Q = subir/descer. O Twinsen fica escondido dentro da nave e a nave
+ * acompanha ao passar para a area vizinha da ilha.
+ */
+#ifndef PILOT_H
+#define PILOT_H
+
+#include <SYSTEM/ADELINE_TYPES.H>
+
+extern S32 PilotEnabled; // cvar "pilot"
+extern S32 PilotSpeed;   // velocidade maxima para frente
+extern S32 PilotMinSize; // tamanho minimo (ZV) para contar como nave
+extern S32 PilotTest;
+extern S32 PilotFlySample; // som do voo da nave Esmer (cvar pilot_flysnd)
+extern S32 PilotDbgAnim, PilotDbgBody, DbgShowBody, DbgShowAnim;    // automacao: bits 1=V 2=E 4=Q 8=A 16=D
+
+S32 Pilot_Active(void);
+S32 Pilot_IsVehicle(S32 numobj); // e o veiculo sendo pilotado
+S32 Pilot_ShipObj(void);          // objeto pilotado (-1: nenhum)
+void Pilot_SetAltitude(S32 y);    // poe a nave nessa altura (chegada do espaco)
+
+// Chamado onde a posicao do heroi e gravada (DoAnim / exterior).
+void Pilot_HeroPos(S32 *x, S32 *y, S32 *z);
+
+// Chamado onde a posicao de qualquer objeto e gravada.
+void Pilot_ObjPos(S32 numobj, S32 *x, S32 *y, S32 *z);
+
+// Enquanto pilota, o heroi fica parado (anim RIEN).
+U16 Pilot_RemapGenAnim(U16 genanim);
+
+// Troca de cena: leva a nave junto (exceto ao carregar save).
+void Pilot_CubeChange(S32 loading);
+void Pilot_AfterSceneInit(void);
+
+// Morte / inicio de jogo.
+void Pilot_Reset(void);
+
+// TRUE se ha uma area vizinha na direcao (dx,dz) - senao a borda e parede.
+S32 Pilot_BlocksPhantom(void);
+void Pilot_List(void);
+void *Pilot_GetAnim(S32 index); // anims virtuais dos veiculos (trem de pouso, helice)
+void Pilot_ShiftWorld(S32 sx, S32 sz); // mar aberto: referencial mudou
+S32 Pilot_DrawOffsetY(S32 numobj); // nave parada no ar sobe e desce (so no desenho)
+void Pilot_DrawFx(S32 numobj);      // luzes e fogo da nave Esmer (logo depois dela)
+double Pilot_Thrust(void);          // motor da nave 0..1
+S32 Pilot_AirHeight(void);
+S32 Pilot_DrawBody(S32 numobj);     // corpo com as luzes do jogo acesas (-1: o normal)
+void *Pilot_GetBody(S32 index);     // corpos virtuais (luzes acesas)          // pilotando nave voadora: altura acima do chao (-1: nao)
+
+#endif
diff --git a/SOURCES/SHIPFX.CPP b/SOURCES/SHIPFX.CPP
new file mode 100644
index 0000000..ec22668
--- /dev/null
+++ b/SOURCES/SHIPFX.CPP
@@ -0,0 +1,225 @@
+/* SHIPFX.CPP - Fogo do escapamento da nave Esmer pilotada (mod). Ver SHIPFX.H.
+ *
+ * No video da nave no espaco (VIDEO.HQR 31) o bocal de tras solta um jato
+ * amarelo-alaranjado; o modelo 3D do jogo nao tem isso. Aqui pontos ao longo
+ * do eixo do bocal sao colocados no referencial da nave (mesma rotacao do
+ * corpo), projetados com a camera da cena e desenhados como brilhos somados a
+ * imagem, logo depois da nave, com teste de z-buffer (construcoes na frente
+ * cobrem). As luzes da nave sao as do proprio jogo (PILOT.CPP, Pilot_DrawBody).
+ */
+#include "C_EXTERN.H"
+#include "SHIPFX.H"
+#include "SPACE.H"
+
+#include <3D/CAMERA.H>
+#include <3D/IMATSTD.H>
+#include <3D/LROT3D.H>
+#include <3D/LPROJ.H>
+#include <OBJECT/AFF_OBJ.H>
+#include <SVGA/SCREEN.H>
+#include <SVGA/DIRTYBOX.H>
+#include <POLYGON/POLY.H>
+#include <math.h>
+
+S32 ShipFxEnabled = TRUE;
+
+/* ---------------------------------------------------------------- cores */
+
+static U8 FxLut[32 * 32 * 32];
+static U16 FxRgb[256];
+static U32 FxPalSum = 0;
+static S32 FxPalOk = FALSE;
+
+static void FxPrepare(void) {
+    U8 *pal = PtrPalCurrent ? PtrPalCurrent : PtrPal;
+    U32 sum = 0;
+    S32 i, r, g, b, mx = 0, k;
+    if (!pal)
+        return;
+    for (i = 0; i < 768; i++) {
+        sum = sum * 31 + pal[i];
+        if (pal[i] > mx)
+            mx = pal[i];
+    }
+    if (FxPalOk AND sum == FxPalSum)
+        return;
+    FxPalOk = TRUE;
+    FxPalSum = sum;
+    k = mx < 64 ? 4 : 1;
+    for (i = 0; i < 256; i++) {
+        S32 cr = pal[i * 3] * k, cg = pal[i * 3 + 1] * k, cb = pal[i * 3 + 2] * k;
+        if (cr > 255) cr = 255;
+        if (cg > 255) cg = 255;
+        if (cb > 255) cb = 255;
+        FxRgb[i] = (U16)(((cr >> 3) << 10) | ((cg >> 3) << 5) | (cb >> 3));
+    }
+    for (r = 0; r < 32; r++)
+        for (g = 0; g < 32; g++)
+            for (b = 0; b < 32; b++) {
+                S32 tr = r * 255 / 31, tg = g * 255 / 31, tb = b * 255 / 31, best = 0, bd = 0x7FFFFFFF;
+                if (k == 4) {
+                    tr >>= 2;
+                    tg >>= 2;
+                    tb >>= 2;
+                }
+                for (i = 1; i < 256; i++) {
+                    S32 dr = pal[i * 3] - tr, dg = pal[i * 3 + 1] - tg, db = pal[i * 3 + 2] - tb;
+                    S32 d = dr * dr * 3 + dg * dg * 4 + db * db * 2;
+                    if (d < bd) {
+                        bd = d;
+                        best = i;
+                    }
+                }
+                FxLut[(r << 10) | (g << 5) | b] = (U8)best;
+            }
+}
+
+// brilho redondo somado a imagem; core = parte central quase branca
+static S32 GlowZ = -1; // profundidade do brilho no z-buffer (-1: sem teste)
+
+static void Glow(S32 cx, S32 cy, S32 rad, double cr, double cg, double cb, double inten, double core) {
+    S32 x, y, x0, y0, x1, y1;
+    // no mini espaco o z-buffer e o da ultima cena desenhada: nao vale
+    U16 *zb = (GlowZ >= 0 AND Fill_Flag_ZBuffer AND PtrZBuffer AND !Space_Active()) ? (U16 *)PtrZBuffer : NULL;
+    if (rad < 1)
+        rad = 1;
+    if (rad > 160)
+        rad = 160;
+    x0 = cx - rad;
+    x1 = cx + rad;
+    y0 = cy - rad;
+    y1 = cy + rad;
+    if (x0 < ClipXMin) x0 = ClipXMin;
+    if (y0 < ClipYMin) y0 = ClipYMin;
+    if (x1 > ClipXMax) x1 = ClipXMax;
+    if (y1 > ClipYMax) y1 = ClipYMax;
+    if (x0 > x1 OR y0 > y1)
+        return;
+    BoxMovingAdd(x0, y0, x1, y1);
+    for (y = y0; y <= y1; y++) {
+        U8 *line = (U8 *)Log + TabOffLine[y];
+        for (x = x0; x <= x1; x++) {
+            double d = sqrt((double)((x - cx) * (x - cx) + (y - cy) * (y - cy))) / rad, w, wc;
+            U32 c;
+            S32 r, g, b;
+            if (d >= 1.0)
+                continue;
+            if (zb AND zb[TabOffLine[y] + x] < (U32)GlowZ)
+                continue; // atras de uma construcao
+            w = (1.0 - d) * (1.0 - d) * inten;
+            wc = d < core ? (d < core * 0.6 ? 1.0 : (1.0 - d / core) / 0.4) * inten : 0.0;
+            c = FxRgb[line[x]];
+            r = (S32)(((c >> 10) & 31) * 8 + cr * w);
+            g = (S32)(((c >> 5) & 31) * 8 + cg * w);
+            b = (S32)((c & 31) * 8 + cb * w);
+            if (wc > 0.0) { // miolo: a cor da luz quase branca, por cima
+                r = (S32)(r + (255 - r) * wc);
+                g = (S32)(g + ((cg + 255) / 2 - g) * wc);
+                b = (S32)(b + ((cb + 235) / 2 - b) * wc);
+            }
+            if (r > 255) r = 255;
+            if (g > 255) g = 255;
+            if (b > 255) b = 255;
+            line[x] = FxLut[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)];
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- pontos */
+
+static TYPE_MAT FxMat;
+static S32 FxX, FxY, FxZ;
+
+// ponto do corpo (referencial da nave) -> mundo
+static void ToWorld(double lx, double ly, double lz, double *wx, double *wy, double *wz) {
+    LongRotatePoint(&FxMat, (S32)lx, (S32)ly, (S32)lz);
+    *wx = FxX + X0;
+    *wy = FxY + Y0;
+    *wz = FxZ + Z0;
+}
+
+// projeta; devolve o raio em pixels de um tamanho do mundo, ou 0 (fora/atras)
+static S32 Project(double wx, double wy, double wz, double size, S32 *sx, S32 *sy) {
+    S32 x1;
+    LongWorldRotatePoint((S32)wx, (S32)wy, (S32)wz);
+    {
+        S32 rx = X0, ry = Y0, rz = Z0;
+        if (!LongProjectPoint(rx, ry, rz))
+            return 0;
+        {
+            S32 depth = CameraZr - rz - 250; // um pouco a frente: nao some no casco
+            GlowZ = depth <= 0 ? 0 : (S32)(((U32)depth * Fill_ZBuffer_Factor) >> 16);
+            if (GlowZ > 65535)
+                GlowZ = 65535;
+        }
+        *sx = Xp;
+        *sy = Yp;
+        if (!LongProjectPoint(rx + (S32)size, ry, rz))
+            return 0;
+        x1 = Xp;
+    }
+    x1 -= *sx;
+    if (x1 < 0)
+        x1 = -x1;
+    return x1 < 1 ? 1 : x1;
+}
+
+// quanto a direcao (no corpo) aponta para a camera: -1..1
+static double Facing(double lx, double ly, double lz, double nx, double ny, double nz) {
+    double px, py, pz, qx, qy, qz, vx, vy, vz, l;
+    ToWorld(lx, ly, lz, &px, &py, &pz);
+    ToWorld(lx + nx * 1000.0, ly + ny * 1000.0, lz + nz * 1000.0, &qx, &qy, &qz);
+    vx = CameraX - px;
+    vy = CameraY - py;
+    vz = CameraZ - pz;
+    l = sqrt(vx * vx + vy * vy + vz * vz);
+    if (l < 1)
+        return 1.0;
+    return ((qx - px) * vx + (qy - py) * vy + (qz - pz) * vz) / (1000.0 * l);
+}
+
+/* ---------------------------------------------------------------- nave */
+
+// medidas do corpo 71 (o mesmo casco dos 70..78)
+#define NOZ_Y 1200.0   // centro do bocal de tras
+#define NOZ_Z -1970.0
+#define NOZ_R 260.0
+
+void ShipFx_Draw(void *obj3d, double thrust) {
+    T_OBJ_3D *o = (T_OBJ_3D *)obj3d;
+    U32 t = TimerRefHR;
+    S32 k;
+    if (!ShipFxEnabled OR !o)
+        return;
+    FxPrepare();
+    if (!FxPalOk)
+        return;
+    InitMatrixStd(&FxMat, o->Alpha, o->Beta, o->Gamma);
+    FxX = o->X;
+    FxY = o->Y;
+    FxZ = o->Z;
+
+    // jato de fogo ao acelerar
+    if (thrust > 0.04) {
+        double fb = Facing(0, NOZ_Y, NOZ_Z, 0, 0, -1);
+        double vis = fb > 0.2 ? 1.0 : (fb < -0.4 ? 0.25 : 0.25 + 0.75 * (fb + 0.4) / 0.6);
+        double len = (900.0 + 1700.0 * thrust) * (0.88 + 0.24 * ((t * 7919u) % 97) / 97.0);
+        S32 n = 14;
+        for (k = n; k >= 0; k--) {
+            double f = (double)k / n, wx, wy, wz, size, r, g, b, in;
+            S32 sx, sy, rad;
+            ToWorld(0, NOZ_Y, NOZ_Z - 40 - len * f, &wx, &wy, &wz);
+            size = NOZ_R * (1.15 - 0.8 * f);
+            // amarelo no bocal, laranja no meio, vermelho na ponta
+            r = 255;
+            g = f < 0.45 ? 230 - 200 * f : 140 - 200 * (f - 0.45);
+            b = f < 0.2 ? 140 - 600 * f : 15;
+            if (g < 40) g = 40;
+            if (b < 15) b = 15;
+            in = thrust * vis * (1.15 - 0.8 * f);
+            rad = Project(wx, wy, wz, size, &sx, &sy);
+            if (rad)
+                Glow(sx, sy, rad + 1, r, g, b, in, f < 0.15 ? 0.4 : 0.0);
+        }
+    }
+}
