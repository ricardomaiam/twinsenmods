+
+void Pilot_AfterSceneInit(void) {
+    T_OBJET *o;
+    S32 n;
+    if (ParkPending) {
+        ParkPending = FALSE;
+        if (NbObjets < MAX_OBJETS) {
+            n = NbObjets++;
+            o = &ListObjet[n];
+            memcpy(o, &ShipBackup, sizeof(T_OBJET));
+            o->OffsetLife = -1; // os roteiros eram da cena antiga
+            o->OffsetTrack = -1;
+            o->Move = NO_MOVE;
+            o->CarryBy = -1;
+            o->ZoneSce = -1;
+            o->SampleAlways = 0;
+            o->PtrFile3D = LoadFile3D(o->IndexFile3D);
+            {
+                S32 gb = o->GenBody, ga = o->GenAnim;
+                o->Obj.Body.Num = -1;
+                InitBody((U8)gb, (U8)n);
+                o->Obj.Anim.Num = -1;
+                o->FlagAnim = 0;
+                o->GenAnim = (U16)-1;
+                InitAnim((U16)ga, ANIM_REPEAT, (U8)n);
+            }
+            LogPrintf("Pilot: veiculo estacionado levado para a cena nova (objeto %d)\n", n);
+        }
+    }
+    if (!CarryPending)
+        return;
+    CarryPending = FALSE;
+    if (!PilotOn)
+        return;
+    if (NbObjets >= MAX_OBJETS) {
+        S32 x = ListObjet[NUM_PERSO].Obj.X, y = ListObjet[NUM_PERSO].Obj.Y, z = ListObjet[NUM_PERSO].Obj.Z;
+        DoExit(&x, &y, &z, TRUE);
+        ListObjet[NUM_PERSO].Obj.X = x;
+        ListObjet[NUM_PERSO].Obj.Y = y;
+        ListObjet[NUM_PERSO].Obj.Z = z;
+        return;
+    }
+
+    n = NbObjets++;
+    o = &ListObjet[n];
+    memcpy(o, &ShipBackup, sizeof(T_OBJET));
+    o->OffsetLife = -1;
+    o->OffsetTrack = -1;
+    o->Move = NO_MOVE;
+    o->CarryBy = -1;
+    o->ZoneSce = -1;
+    o->SampleAlways = 0;
+    o->PtrFile3D = LoadFile3D(o->IndexFile3D);
+    o->Obj.Body.Num = -1;
+    InitBody(o->GenBody, (U8)n);
+    o->Obj.Anim.Num = -1;
+    o->FlagAnim = 0;
+    InitAnim(o->GenAnim, ANIM_REPEAT, (U8)n);
+
+    ShipX = ListObjet[NUM_PERSO].Obj.X;
+    ShipZ = ListObjet[NUM_PERSO].Obj.Z;
+    o->Obj.X = ShipX;
+    o->Obj.Y = ShipY;
+    o->Obj.Z = ShipZ;
+    o->Obj.Beta = ShipBeta;
+    PilotObj = n;
+    NumObjFollow = (U8)n;
+    // o RestartPerso da cena nova devolveu ao heroi as flags normais: esconde ja,
+    // antes do primeiro desenho
+    ListObjet[NUM_PERSO].Flags |= INVISIBLE | NO_SHADOW;
+    ListObjet[NUM_PERSO].Flags &= ~PILOT_COLFLAGS;
+    LogPrintf("Pilot: nave levada para a cena nova (objeto %d)\n", n);
+}
