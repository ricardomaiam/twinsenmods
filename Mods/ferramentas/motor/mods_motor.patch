+/* ------------------------------------------------------------------------
+   Desenho da nave Esmer pilotada: parada no ar ela "respira" (sobe e desce
+   um pouco, motor trabalhando), e tem luzes e fogo do escapamento (SHIPFX).
+   O deslocamento e so no desenho: a camera e a fisica nao balancam.
+   ------------------------------------------------------------------------ */
+S32 Pilot_DrawOffsetY(S32 numobj) {
+    T_OBJET *o;
+    double spd, amp;
+    if (!PilotOn OR numobj != PilotObj OR Space_Active())
+        return 0;
+    o = &ListObjet[numobj];
+    if (o->IndexFile3D != ESMER_FILE3D OR IsDino(o) OR !GearUp)
+        return 0;
+    spd = CurSpeed < 0 ? -CurSpeed : CurSpeed;
+    amp = 1.0 - spd / (PilotSpeed > 0 ? PilotSpeed : 1);
+    if (amp < 0.0)
+        amp = 0.0;
+    return (S32)(110.0 * amp * sin(TimerRefHR * (2.0 * 3.14159265358979 / 2200.0)));
+}
