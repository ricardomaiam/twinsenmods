+void Pilot_Reset(void) {
+    VehicleSoundsExit(NULL);
+    if (PilotOn) {
+        T_OBJET *hero = &ListObjet[NUM_PERSO];
+        hero->Flags &= ~(INVISIBLE | NO_SHADOW);
+        hero->Flags |= HeroFlagsSaved | HeroColSaved;
+        Fly_SetView(FALSE, 0, 0);
+        FlyExtraDist = 0;
+        NumObjFollow = NUM_PERSO;
+    }
+    PilotOn = FALSE;
+    PilotObj = -1;
+    CarryPending = FALSE;
+    LastTime = 0;
+}
